:root{--ux-ring:0 0 0 3px color-mix(in srgb,var(--cyan) 28%,transparent)}
html,body{max-width:100%;overflow-x:hidden}.visually-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
button,.btn,input,select,textarea{min-height:44px}button:focus-visible,.btn:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--cyan);outline-offset:2px;box-shadow:var(--ux-ring)}
.ux-muted{color:var(--muted);font-size:12px}.ux-empty{padding:18px;color:var(--muted);text-align:center}.ux-hero-compact h1,.ux-home-head h1{margin:.25rem 0 .45rem}.ux-hero-compact p,.ux-home-head p{margin:0;color:var(--muted);max-width:760px}.ux-home-head{margin:10px 0 18px}
.ux-next-shift{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px;border:1px solid #36d7ff55;border-radius:18px;background:linear-gradient(145deg,#0f2638,#0b1825);box-shadow:0 14px 38px #0004}.ux-next-shift.empty{border-color:var(--line)}.ux-next-shift h2{font-size:clamp(30px,7vw,52px);margin:4px 0 0}.ux-next-time{font-size:clamp(28px,7vw,48px);font-weight:850;letter-spacing:-.03em}.ux-next-shift p{margin:4px 0 12px;color:var(--muted)}.ux-big-action{min-height:52px;padding:13px 18px;font-size:16px}
.ux-section-title{display:flex;justify-content:space-between;align-items:center;gap:12px;margin:22px 0 10px}.ux-section-title h2{margin:0}.ux-upcoming-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.ux-upcoming-card{display:flex;flex-direction:column;gap:4px;padding:14px;border:1px solid var(--line);border-radius:14px;background:#0b1927}.ux-upcoming-card strong{font-size:18px}.ux-upcoming-card span{font-size:20px;font-weight:750}.ux-upcoming-card small{color:var(--muted)}
.ux-request-hub{margin-top:22px}.ux-task-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.ux-task-grid button{display:flex;flex-direction:column;align-items:flex-start;text-align:left;gap:6px;padding:18px;border:1px solid var(--line);border-radius:15px;background:linear-gradient(180deg,#0d1b2acc,#0a1724dd);color:var(--text)}.ux-task-grid button:hover{border-color:#36d7ff66;transform:translateY(-1px)}.ux-task-grid strong{font-size:17px}.ux-task-grid span{color:var(--muted);font-size:13px}.ux-request-summary,.ux-history-row{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:13px 14px;border:1px solid var(--line);border-radius:13px;background:#0b1927;margin:8px 0}.ux-request-summary>div,.ux-history-row>div{display:flex;flex-direction:column;gap:4px}.ux-request-summary span,.ux-history-row span{color:var(--muted);font-size:12px}
.ux-status{display:inline-flex;align-items:center;justify-content:center;min-height:30px;padding:5px 9px;border:1px solid var(--line);border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.03em;white-space:nowrap}.ux-status.ok{color:var(--green);border-color:#45d48366}.ux-status.warn{color:var(--yellow);border-color:#ffc85766}.ux-status.bad{color:var(--red);border-color:#ff6b6b66}
.ux-toolbar{display:flex;flex-wrap:wrap;align-items:end;gap:10px;margin:14px 0 16px;padding:12px;border:1px solid var(--line);border-radius:14px;background:#0b1927}.ux-toolbar-group{display:flex;gap:6px;flex-wrap:wrap}.ux-filter{min-height:40px;padding:8px 11px;border:1px solid var(--line);border-radius:10px;background:transparent;color:var(--muted);font-weight:700}.ux-filter.active{background:#12314a;color:var(--text);border-color:#36d7ff66}.ux-doctor-search{display:flex;flex-direction:column;gap:5px;min-width:min(100%,240px)}.ux-doctor-search span{font-size:12px;color:var(--muted)}.ux-doctor-search select{background:#071522;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:9px 10px}
.ux-schedule-list{display:grid;gap:12px}.ux-day-block{border:1px solid var(--line);border-radius:15px;overflow:hidden;background:#0b1927}.ux-day-heading{display:flex;justify-content:space-between;padding:11px 14px;border-bottom:1px solid var(--line);background:#ffffff04;text-transform:capitalize}.ux-day-heading>div{display:flex;gap:8px;align-items:baseline}.ux-day-heading span{font-size:12px;color:var(--muted)}.ux-shift-row{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:12px 14px;border-top:1px solid #ffffff09}.ux-shift-row:first-of-type{border-top:0}.ux-shift-row.is-own{background:#36d7ff09;box-shadow:inset 3px 0 var(--cyan)}.ux-shift-main{display:flex;align-items:center;gap:14px;min-width:0}.ux-shift-time{font-size:18px;font-weight:850;min-width:108px}.ux-shift-side{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}.ux-schedule-list.compact{gap:0}.ux-schedule-list.compact .ux-shift-row{border:1px solid var(--line);border-radius:12px;margin-top:8px}
.ux-callout{display:flex;justify-content:space-between;align-items:center;gap:16px}.ux-callout h2{margin:0 0 5px}.ux-callout p{margin:0}.ux-inline-identify{display:flex;align-items:end;gap:8px}.ux-inline-identify label{display:flex;flex-direction:column;gap:5px}.ux-inline-identify span{font-size:12px;color:var(--muted)}.ux-inline-identify input{background:#071522;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:9px 10px}
.ux-flow-card,.ux-guided-request{max-width:760px;margin:0 auto}.ux-back-link{border:0;background:transparent;color:var(--cyan);padding:0 0 12px;font-weight:700}.ux-shift-picker{display:grid;gap:9px}.ux-shift-picker button{display:flex;flex-direction:column;align-items:flex-start;text-align:left;gap:4px;padding:14px;border:1px solid var(--line);border-radius:12px;background:#071522;color:var(--text)}.ux-shift-picker butt