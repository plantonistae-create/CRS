function newRequestForm(){const myShifts=(state.data.shifts||[]).filter(s=>s.doctorId===state.session.id),docs=Object.values(state.data.doctors||{}).filter(d=>d.id!==state.session.id);return `<section class="card" id="new-request-card"><h2>Nova solicitação</h2><form id="request-form" class="form-grid"><div class="field"><label>Tipo</label><select name="type"><option value="atestado">Atestado</option><option value="ausencia">Ausência / plantão passado</option><option value="troca">Troca de plantão</option><option value="pagamento">Pagamento de horas</option><option value="extra">Plantão extra</option></select></div><div class="field"><label>Data do fato/plantão</label><input type="date" name="eventDate" required></div><div class="field"><label>Horas</label><input type="number" step="0.5" name="hours" value="12" required></div><div class="field"><label>Plantão relacionado (se houver)</label><select name="shiftId"><option value="">—</option>${myShifts.map(s=>`<option value="${s.id}">${fmtDate(s.date)} · ${s.start}–${s.end} · ${FN[s.function]}</option>`).join('')}</select></div><div class="field"><label>Médico substituto (troca)</label><select name="targetDoctorId"><option value="">—</option>${docs.map(d=>`<option value="${d.id}">${esc(d.name)}</option>`).join('')}</select></div><div class="field"><label>Início (extra/pagamento)</label><input type="time" name="start" value="07:00"></div><div class="field"><label>Fim</label><input type="time" name="end" value="19:00"></div>${functionSelect('function')}${categorySelect('category','eventual')}<div class="field span2"><label>Observação</label><textarea name="notes"></textarea></div><div class="field span2"><label>Motivo se retroativo</label><input name="retroReason" placeholder="Obrigatório se a data já passou"></div><div class="field span2"><label>Documento (atestado, opcional nos demais)</label><input type="file" name="file" accept="application/pdf,image/jpeg,image/png,image/webp"></div><div class="field"><label>&nbsp;</label><button class="btn primary" type="submit">Enviar solicitação</button></div></form></section>`;}
function mineView(){const s=state.data.mySummary||{},next=(state.data.shifts||[]).filter(x=>x.doctorId===state.session.id&&x.date>=new Date().toISOString().slice(0,10)).sort((a,b)=>a.date.localeCompare(b.date))[0];return `<div class="hero"><div><div class="eyebrow">Meu painel</div><h1>${esc(state.session.name)}</h1><p>${next?`Próximo plantão: ${fmtDate(next.date)} · ${next.start}–${next.end} · ${FN[next.function]}`:'Nenhum plantão futuro encontrado neste mês.'}</p></div>${monthbar()}</div><div class="grid metrics"><div class="metric"><small>Carga prevista</small><div class="num">${s.plannedHours||0}h</div></div><div class="metric"><small>Atestados</small><div class="num">${s.attestationHours||0}h</div><div class="sub">${s.attestationPercent||0}% / limite 25%</div></div><div class="metric"><small>Saldo a compensar</small><div class="num">${s.balanceHours||0}h</div></div><div class="metric"><small>Extras</small><div class="num">${s.extraHours||0}h</div></div></div><section class="section"><div class="actions"><button class="btn primary" data-route="requests">Enviar solicitação</button><button class="btn" data-route="public">Ver escala completa</button><button class="btn" data-action="notifications">🔔 Notificações</button></div></section><section class="section"><h2>Minha escala no mês</h2>${(state.data.shifts||[]).filter(x=>x.doctorId===state.session.id).map(s=>`<div class="card" style="margin:8px 0">${shiftCard(s,false)}</div>`).join('')||'<div class="card muted">Sem plantões neste mês.</div>'}</section>`;}
function auditView(){return `<div class="hero"><div><div class="eyebrow">Rastreabilidade</div><h1>Auditoria</h1><p>Histórico administrativo append-only das ações da escala.</p></div></div>${(state.data.audit||[]).map(a=>`<div class="card audit" style="margin:8px 0"><b>${fmtTs(a.occurredAt)} · ${esc(a.actorRole)} · ${esc(a.action)}</b>\n${esc(a.entityType)} ${esc(a.entityId||'')}\n${esc(JSON.stringify(a.current||{},null,2))}</div>`).join('')||'<div class="card muted">Sem eventos.</div>'}`;}
