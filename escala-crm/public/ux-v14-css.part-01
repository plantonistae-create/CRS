on:hover{border-color:#36d7ff66}.ux-shift-picker span{color:var(--muted);font-size:12px}.ux-step-block{display:grid;grid-template-columns:42px 1fr;gap:12px;margin:14px 0}.ux-step-number{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#12314a;border:1px solid #36d7ff55;color:var(--cyan);font-weight:850}.ux-step-content h3{margin:5px 0 10px}.ux-review-box{display:flex;flex-direction:column;gap:4px;padding:12px;border:1px solid var(--line);border-radius:12px;background:#ffffff04}.ux-review-box span{color:var(--muted);font-size:12px}.ux-period-grid,.ux-upload-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.ux-upload-button{display:flex;align-items:center;justify-content:center;min-height:50px;border:1px dashed #36d7ff77;border-radius:12px;background:#36d7ff08;color:var(--text);font-weight:750;cursor:pointer}.ux-file-name{margin-top:8px;color:var(--muted);font-size:12px}.ux-confirm-note{margin:10px 0;padding:10px 12px;border-left:3px solid var(--cyan);background:#36d7ff08;color:var(--muted);border-radius:8px}.ux-form-actions{margin-top:10px}
.ux-request-card{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:14px;border:1px solid var(--line);border-radius:14px;background:#0b1927;margin:8px 0}.ux-request-card>div:first-child{display:flex;flex-direction:column;gap:3px}.ux-request-card span,.ux-request-card small{color:var(--muted);font-size:12px}.ux-request-card .actions{grid-column:1/-1}
.ux-pending-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.ux-pending-grid button{display:flex;flex-direction:column;align-items:flex-start;gap:6px;padding:16px;border:1px solid var(--line);border-radius:15px;background:linear-gradient(180deg,#0d1b2acc,#0a1724dd);color:var(--text);text-align:left}.ux-pending-grid span{color:var(--muted);font-size:12px}.ux-pending-grid strong{font-size:32px}.ux-today-card{margin-top:18px;padding:16px;border:1px solid var(--line);border-radius:16px;background:#0b1927}.ux-today-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.ux-today-metrics>div{padding:12px;border:1px solid var(--line);border-radius:12px;background:#ffffff04}.ux-today-metrics span{display:block;color:var(--muted);font-size:12px}.ux-today-metrics strong{font-size:26px}
.ux-admin-request{padding:16px;border:1px solid var(--line);border-radius:15px;background:#0b1927;margin:10px 0}.ux-admin-request-head{display:flex;justify-content:space-between;gap:12px}.ux-admin-request h3{margin:3px 0}.ux-admin-request p{margin:3px 0;color:var(--muted)}.ux-detail-line{display:flex;justify-content:space-between;gap:12px;padding:8px 0;border-top:1px solid #ffffff09}.ux-detail-line span{color:var(--muted);font-size:12px}.ux-impact{display:flex;flex-direction:column;gap:4px;padding:10px 12px;margin:10px 0;border-radius:10px;border:1px solid var(--line)}.ux-impact.ok{border-color:#45d48366}.ux-impact.warn{border-color:#ffc85766}.ux-impact.bad{border-color:#ff6b6b66}.ux-impact span{font-size:12px;color:var(--muted)}.ux-admin-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:10px 0}.ux-admin-fields label{display:flex;flex-direction:column;gap:5px;color:var(--muted);font-size:12px}.ux-admin-fields select{background:#071522;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:9px}.ux-admin-request-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.ux-admin-tools{margin-top:18px}.ux-admin-tools summary{cursor:pointer;font-weight:800}.ux-admin-tools-body{margin-top:14px}
.ux-month-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ux-login-intro{max-width:680px;margin:28px auto 8px;text-align:center}.ux-login-intro h1{font-size:clamp(30px,5vw,48px);margin:.3rem 0}.ux-login-intro p{color:var(--muted);margin:0 auto}.ux-public-entry{padding-top:1px}
html[data-theme="light"] .ux-next-shift,html[data-theme="light"] .ux-upcoming-card,html[data-theme="light"] .ux-task-grid button,html[data-theme="light"] .ux-request-summary,html[data-theme="light"] .ux-history-row,html[data-theme="light"] .ux-toolbar,html[data-theme="light"] .ux-day-block,html[data-theme="light"] .ux-callout,html[data-theme="light"] .ux-request-card,html[data-theme="light"] .ux-pending-grid button,html[data-theme="light"] .ux-today-card,html[data-theme="light"] .ux-admin-request{background:#fff}.ux-task-grid button,.ux-pending-grid button{transition:transform .12s ease,border-color .12s ease}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}}
@media(max-width:900px){.ux-pending-grid,.ux-today-metrics{grid-template-columns:1fr 1fr}.ux-upcoming-grid{grid-template-columns:1fr 1fr}.ux-month-grid{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.ux-next-shift{align-items:flex-start;flex-direction:column;padding:17px}.ux-next-shift .ux-big-action{width:100%}.ux-upcoming-grid,.ux-task-grid,.ux-pending-grid,.ux-today-metrics,.ux-month-grid,.ux-period-grid,.ux-upload-grid,.ux-admin-fields{grid-template-columns:1fr}.ux-toolbar{align-items:stretch}.ux-toolbar-group{display:grid;grid-template-columns:repeat(4,1fr)}.ux-toolbar-group:nth-of-type(2){grid-template-columns:1fr 1fr}.ux-filter{padding:8px 5px;font-size:12px}.ux-doctor-search{width:100%}.ux-shift-row{align-items:flex-start;flex-direction:column}.ux-shift-side{width:100%;justify-content:space-between}.ux-shift-main{width:100%}.ux-shift-time{min-width:98px}.ux-inline-identify,.ux-callout{flex-direction:column;align-items:stretch}.ux-step-block{grid-template-columns:34px 1fr}.ux-step-number{width:32px;height:32px}.ux-request-card{grid-template-columns:1fr}.ux-request-card .ux-status{justify-self:start}.ux-admin-request-head{flex-direction:co