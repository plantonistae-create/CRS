function notificationsView(){const rows=state.data.notifications||[];return `<div class="hero"><div><div class="eyebrow">Tempo real</div><h1>Notificações</h1><p>Alertas administrativos e decisões recentes.</p></div><button class="btn" data-action="enable-notifications">Ativar notificações do navegador</button></div>${rows.map(n=>`<div class="notice ${n.read_at?'':'unread'}"><strong>${esc(n.title)}</strong><div>${esc(n.body)}</div><small>${fmtTs(n.created_at?new Date(Number(n.created_at)).toISOString():n.createdAt)}</small>${!n.read_at?`<div><button class="btn small" data-notif-read="${n.id}">Marcar como lida</button></div>`:''}</div>`).join('')||'<div class="card muted">Nenhuma notificação.</div>'}`;}
function doctorSelect(name){return `<div class="field"><label>Médico</label><select name="${name}" required><option value="">Selecione</option>${(state.data.doctorsList||[]).filter(d=>d.active).map(d=>`<option value="${d.id}">${esc(d.name)}</option>`).join('')}</select></div>`;}
function functionSelect(name){return `<div class="field"><label>Função</label><select name="${name}"><option value="emergencia_enfermaria">Emergência + Enfermaria</option><option value="fichas">Fichas</option><option value="enfermaria">Enfermaria</option><option value="cinderela">Cinderela</option></select></div>`;}
function categorySelect(name,def='fixo'){return `<div class="field"><label>Tipo do plantonista</label><select name="${name}"><option value="fixo" ${def==='fixo'?'selected':''}>Fixo</option><option value="eventual" ${def==='eventual'?'selected':''}>Eventual</option><option value="pagamento" ${def==='pagamento'?'selected':''}>Pagamento de horas</option></select></div>`;}
function render(){const app=$('#app');let body='';if(!state.session)body=`<div class="hero"><div><div class="eyebrow">CS Coophavila</div><h1>Gestão de Escala Médica</h1><p>Acesso restrito aos profissionais autorizados. A escala é compartilhada em tempo real entre os usuários da unidade.</p></div></div>${loginBlock()}`;else if(state.route==='notifications')body=notificationsView();else if(state.route==='public')body=publicView();else if(state.session.role==='admin'){body=state.route==='dashboard'?dashboard():state.route==='schedule'?scheduleAdmin():state.route==='templates'?templatesView():state.route==='doctors'?doctorsView():state.route==='requests'?requestsView():auditView();}else if(state.session.role==='doctor'){body=state.route==='mine'?mineView():state.route==='requests'?requestsView():publicView();}else{body=publicView();}app.innerHTML=`<div class="shell">${topbar()}<main class="content">${body}</main></div><div id="toast" class="toast"></div>`;bind();}
function bind(){$$('[data-route]').forEach(b=>b.onclick=()=>{state.route=b.dataset.route;render()});$$('[data-month]').forEach(b=>b.onclick=()=>monthMove(Number(b.dataset.month)));$$('[data-login-mode]').forEach(b=>b.onclick=()=>{state.loginMode=b.dataset.loginMode;render()});$('#login-form')?.addEventListener('submit',login);$('#identify-form')?.addEventListener('submit',identifyCrm);$('#unit-access-form')?.addEventListener('submit',setUnitAccess);$('[data-action="logout"]')?.addEventListener('click',logout);$('[data-action="unidentify"]')?.addEventListener('click',unidentify);$('[data-action="notifications"]')?.addEventListener('click',()=>{state.route='notifications';render()});$('[data-action="enable-notifications"]')?.addEventListener('click',async()=>{if(!('Notification'in window))return toast('Este navegador não oferece notificações.',true);const p=await Notification.requestPermission();toast(p==='granted'?'Notificações ativadas.':'Permissão não concedida.',p!=='granted')});
