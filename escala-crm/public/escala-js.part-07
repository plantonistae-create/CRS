$('#doctor-form')?.addEventListener('submit',submitDoctor);$('#template-form')?.addEventListener('submit',submitTemplate);$('#shift-form')?.addEventListener('submit',submitShift);$('#record-form')?.addEventListener('submit',submitRecord);$('#request-form')?.addEventListener('submit',submitRequest);$$('[data-template-delete]').forEach(b=>b.onclick=()=>delTemplate(b.dataset.templateDelete));$('[data-action="generate"]')?.addEventListener('click',generateMonth);$$('[data-shift-remove]').forEach(b=>b.onclick=()=>removeShift(b.dataset.shiftRemove));$$('[data-shift-replace]').forEach(b=>b.onclick=()=>replaceShift(b.dataset.shiftReplace));$$('[data-reset-crm]').forEach(b=>b.onclick=()=>resetCrm(b.dataset.resetCrm));$$('[data-decide]').forEach(b=>b.onclick=()=>decide(b));$$('[data-peer]').forEach(b=>b.onclick=()=>peer(b));$$('[data-notif-read]').forEach(b=>b.onclick=()=>markNotif(b.dataset.notifRead));}
async function login(e){e.preventDefault();const f=new FormData(e.currentTarget);try{if(state.loginMode==='admin'){const st=await api('/api/auth/admin/status');state.adminConfigured=st.configured;state.unitAccessConfigured=st.unitAccessConfigured;if(st.configured)await post('/api/auth/admin/login',{password:f.get('password')});else await post('/api/auth/admin/bootstrap',{name:'Administrador',password:f.get('password'),accessCode:f.get('accessCode')});}else await post('/api/auth/unit/login',{accessCode:f.get('accessCode')});await detectSession();await load();connectWs();toast('Acesso realizado.');}catch(err){toast(err.message,true)}}
async function logout(){try{if(state.session?.role==='admin')await post('/api/auth/admin/logout',{});else await post('/api/auth/unit/logout',{});}catch{}state.session=null;state.route='login';state.data=null;render();}
async function identifyCrm(e){e.preventDefault();const f=new FormData(e.currentTarget);try{await post('/api/auth/identify',{crm:f.get('crm')});await detectSession();await load();connectWs();toast('CRM identificado.');}catch(err){toast(err.message,true)}}
async function unidentify(){try{await post('/api/auth/unidentify',{});}catch{}await detectSession();await load();connectWs();toast('Identificação encerrada; a escala compartilhada continua disponível.');}
async function setUnitAccess(e){e.preventDefault();const f=new FormData(e.currentTarget);try{await post('/api/admin/unit-access',{accessCode:f.get('accessCode')});toast('Código compartilhado atualizado.');}catch(err){toast(err.message,true)}}
async function submitDoctor(e){e.preventDefault();const f=Object.fromEntries(new FormData(e.currentTarget));try{await post('/api/admin/doctors',f);toast('Médico cadastrado.');await load();}catch(err){toast(err.message,true)}}
async function resetCrm(id){const crm=prompt('Novo CRM com 5 dígitos:');if(!crm)return;try{await post(`/api/admin/doctors/${id}/crm`,{crm});toast('CRM atualizado.');await load();}catch(e){toast(e.message,true)}}
async function submitTemplate(e){e.preventDefault();const f=Object.fromEntries(new FormData(e.currentTarget));f.weekday=Number(f.weekday);f.hours=Number(f.hours);try{await post('/api/admin/templates',f);toast('Padrão adicionado.');await load();}catch(err){toast(err.message,true)}}
async function delTemplate(id){if(!confirm('Remover este item do padrão semanal?'))return;try{await api(`/api/admin/templates/${id}`,{method:'DELETE'});toast('Removido.');await load();}catch(e){toast(e.message,true)}}
async function generateMonth(){if(!confirm(`Gerar ${monthLabel(state.month)} pelo padrão semanal? Alterações pontuais já travadas serão preservadas.`))return;try{const d=await post('/api/admin/generate-month',{month:state.month});toast(`${d.created} plantões gerados.`);await load();}catch(e){toast(e.message,true)}}
async function submitShift(e){e.preventDefault();const f=Object.fromEntries(new FormData(e.currentTarget));f.hours=Number(f.hours);try{await post('/api/admin/shifts',f);toast('Plantão adicionado.');await load();}catch(err){toast(err.message,true)}}
async function removeShift(id){if(!confirm('Remover este plantonista deste dia?'))return;try{await post(`/api/admin/shifts/${id}/remove`,{});toast('Plantão removido.');await load();}catch(e){toast(e.message,true)}}
