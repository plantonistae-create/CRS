async function submitRequest(e){e.preventDefault();const fd=new FormData(e.currentTarget),file=fd.get('file'),body=Object.fromEntries(fd);delete body.file;body.hours=Number(body.hours);if(!body.targetDoctorId)delete body.targetDoctorId;try{const d=await post('/api/requests',body);if(file&&file.size){const up=new FormData();up.append('file',file);await api(`/api/requests/${d.request.id}/attachment`,{method:'POST',body:up});}state.requestDraft=null;toast(`Solicitação enviada: ${d.request.protocol}`);await load();}catch(err){toast(err.message,true)}}
