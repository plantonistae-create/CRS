function doctorRequests(){const rows=state.data.myRequests||[];let cards='';for(const r of rows){const peer=r.type==='troca'&&r.targetDoctorId===state.session.id&&r.status==='pending_peer'?`<button class="btn good small" data-peer="${r.id}" data-accept="1">Aceitar</button><button class="btn danger small" data-peer="${r.id}" data-accept="0">Recusar</button>`:'';cards+=`<div class="request-card"><div><h3>${esc(TYPE[r.type])} · ${esc(r.protocol)}</h3><p>${fmtDate(r.eventDate)} · ${r.hours}h · <span class="status ${r.status}">${esc(r.status)}</span></p><p>Enviado: ${fmtTs(r.submittedAt)}</p></div><div class="actions">${peer}</div></div>`;}return `<div class="hero"><div><div class="eyebrow">Área do médico</div><h1>Minhas solicitações</h1><p>Novas solicitações são abertas a partir de um plantão futuro em Meus plantões.</p></div><button class="btn" data-route="mine">← Meus plantões</button></div>${state.requestDraft?newRequestForm():''}<section class="section">${cards||'<div class="card muted">Nenhuma solicitação.</div>'}</section>`;}
