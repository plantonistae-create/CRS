function mineView(){const sum=state.data.mySummary||{},all=(state.data.shifts||[]).filter(x=>x.doctorId===state.session.id),n=doctorNow(),past=s=>s.date<n.date||(s.date===n.date&&s.end<=n.time&&s.end>s.start),future=all.filter(x=>!past(x)).sort((a,b)=>(a.date+a.start).localeCompare(b.date+b.start)),done=all.filter(past).sort((a,b)=>(b.date+b.start).localeCompare(a.date+a.start)),eventualDone=done.filter(x=>x.category==='eventual'),req=(state.data.myRequests||[]).filter(r=>String(r.eventDate||'').startsWith(state.month)),approved=r=>['approved','aprovado'].includes(String(r.status||'').toLowerCase()),cert=req.filter(r=>r.type==='atestado'&&approved(r)),passed=req.filter(r=>['ausencia','troca'].includes(r.type)&&approved(r)),next=future[0];const history=done.map(s=>`<div class="request-card"><div><h3>${fmtDate(s.date)} · ${s.start}–${s.end}</h3><p>${s.hours}h · ${esc(FN[s.function]||s.function)}</p><span class="chip ${s.category==='eventual'?'yellow':s.category==='pagamento'?'purple':'green'}">${s.category==='eventual'?'EVENTUAL REALIZADO':esc(CAT[s.category]||s.category)}</span></div></div>`).join('');const passedCards=passed.map(r=>`<div class="request-card"><div><h3>${fmtDate(r.eventDate)} · ${esc(TYPE[r.type]||r.type)}</h3><p>${r.hours}h${r.notes?` · ${esc(r.notes)}`:''}</p><p>Solicitado em ${fmtTs(r.submittedAt)}</p></div></div>`).join('');return `<div class="hero"><div><div class="eyebrow">Área do médico</div><h1>${esc(state.session.name)}</h1><p>${next?`Próximo plantão: ${fmtDate(next.date)} · ${next.start}–${next.end} · ${FN[next.function]}`:'Nenhum plantão futuro encontrado.'}</p></div>${monthbar()}</div><div class="grid metrics"><div class="metric"><small>Plantões realizados</small><div class="num">${done.length}</div></div><div class="metric"><small>Eventuais realizados</small><div class="num">${eventualDone.length}</div><div class="sub">${eventualDone.reduce((a,s)=>a+Number(s.hours||0),0)}h</div></div><div class="metric"><small>Atestados</small><div class="num">${cert.length}</div><div class="sub">${sum.attestationHours||0}h · ${sum.attestationPercent||0}%</div></div><div class="metric"><small>Plantões passados/cedidos</small><div class="num">${passed.length}</div></div><div class="metric"><small>Saldo a compensar</small><div class="num">${sum.balanceHours||0}h</div></div></div><section class="section"><h2>Meus plantões futuros</h2>${future.map(s=>`<div class="card" style="margin:10px 0">${shiftCard(s,false)}<div class="actions" style="margin-top:10px"><button class="btn small" onclick="state.requestDraft={shiftId:'${s.id}',type:'troca'};state.route='requests';render()">Troca</button><button class="btn small" onclick="state.requestDraft={shiftId:'${s.id}',type:'atestado'};state.route='requests';render()">Atestado</button><button class="btn small" onclick="state.requestDraft={shiftId:'${s.id}',type:'ausencia'};state.route='requests';render()">Passar plantão</button><button class="btn small" onclick="state.requestDraft={shiftId:'${s.id}',type:'pagamento'};state.route='requests';render()">Pagamento de horas</button></div></div>`).join('')||'<div class="card muted">Sem plantões futuros.</div>'}</section><section class="section"><h2>Plantões realizados no mês</h2>${history||'<div class="card muted">Nenhum plantão realizado neste mês.</div>'}</section><section class="section"><h2>Plantões passados / cedidos</h2>${passedCards||'<div class="card muted">Nenhum plantão passado ou cedido neste mês.</div>'}</section>`;}
