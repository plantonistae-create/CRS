function mineView(){const sum=state.data.mySummary||{},future=(state.data.shifts||[]).filter(x=>x.doctorId===state.session.id&&futureDoctorShift(x)).sort((a,b)=>(a.date+a.start).localeCompare(b.date+b.start)),next=future[0];return `<div class="hero"><div><div class="eyebrow">Área do médico</div><h1>${esc(state.session.name)}</h1><p>${next?`Próximo plantão: ${fmtDate(next.date)} · ${next.start}–${next.end} · ${FN[next.function]}`:'Nenhum plantão futuro encontrado.'}</p></div>${monthbar()}</div><div class="grid metrics"><div class="metric"><small>Carga prevista</small><div class="num">${sum.plannedHours||0}h</div></div><div class="metric"><small>Atestados</small><div class="num">${sum.attestationHours||0}h</div><div class="sub">${sum.attestationPercent||0}% / limite 25%</div></div><div class="metric"><small>Saldo a compensar</small><div class="num">${sum.balanceHours||0}h</div></div><div class="metric"><small>Extras</small><div class="num">${sum.extraHours||0}h</div></div></div><section class="section"><h2>Meus plantões futuros</h2>${future.map(s=>`<div class="card" style="margin:10px 0">${shiftCard(s,false)}<div class="actions" style="margin-top:10px"><button class="btn small" onclick="state.requestDraft={shiftId:'${s.id}',type:'troca'};state.route='requests';render()">Troca</button><button class="btn small" onclick="state.requestDraft={shiftId:'${s.id}',type:'atestado'};state.route='requests';render()">Atestado</button><button class="btn small" onclick="state.requestDraft={shiftId:'${s.id}',type:'ausencia'};state.route='requests';render()">Passar plantão</button><button class="btn small" onclick="state.requestDraft={shiftId:'${s.id}',type:'pagamento'};state.route='requests';render()">Pagamento de horas</button></div></div>`).join('')||'<div class="card muted">Sem plantões futuros.</div>'}</section>`;}
