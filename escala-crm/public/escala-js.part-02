function loginBlock(){const firstAdmin=state.loginMode==='admin'&&!state.adminConfigured;return `<div class="login-panel" id="login-panel"><div class="eyebrow">Acesso à escala</div><h2>${state.loginMode==='unit'?'Escala compartilhada':'Administração'}</h2><div class="login-tabs"><button class="${state.loginMode==='unit'?'active':''}" data-login-mode="unit">Acesso da unidade</button><button class="${state.loginMode==='admin'?'active':''}" data-login-mode="admin">Administrador</button></div><form id="login-form" class="grid">${state.loginMode==='unit'?`<div class="field"><label>Código compartilhado da unidade</label><input name="accessCode" type="password" autocomplete="current-password" required><small>Digite uma vez neste aparelho para consultar a escala.</small></div>`:`<div class="field"><label>Senha administrativa</label><input name="password" type="password" autocomplete="current-password" minlength="8" required></div>${firstAdmin?`<div class="field"><label>Crie também o código compartilhado dos médicos</label><input name="accessCode" type="password" minlength="4" required><small>Este será o código único que você poderá compartilhar com toda a equipe.</small></div>`:''}`}<button class="btn primary" type="submit">${state.loginMode==='unit'?'Abrir escala':'Entrar'}</button></form></div>`;}
function dashboard(){const s=state.data.summaries||[],pending=(state.data.requests||[]).filter(r=>['pending','pending_admin'].includes(r.status)).length,near=s.filter(x=>x.attestationPercent>=20&&x.attestationPercent<25).length,over=s.filter(x=>x.attestationPercent>=25).length,unread=(state.data.notifications||[]).filter(n=>!n.read_at).length;return `<div class="hero"><div><div class="eyebrow">Administração</div><h1>Painel da escala</h1><p>Solicitações, atestados, compensações e capacidade de extras em tempo real.</p></div>${monthbar()}</div><div class="grid metrics"><div class="metric"><small>Solicitações pendentes</small><div class="num">${pending}</div></div><div class="metric"><small>Notificações não lidas</small><div class="num">${unread}</div></div><div class="metric"><small>Próximos de 25%</small><div class="num">${near}</div></div><div class="metric"><small>Em/Acima de 25%</small><div class="num ${over?'kpi-alert':''}">${over}</div></div></div><section class="card"><h2>Acesso compartilhado da equipe</h2><p class="muted">Defina ou troque o código universal usado pelos médicos para consultar a escala. Alterar o código desconecta acessos compartilhados antigos.</p><form id="unit-access-form" class="form-grid"><div class="field"><label>Novo código da unidade</label><input name="accessCode" type="password" minlength="4" required></div><div class="field"><label>&nbsp;</label><button class="btn" type="submit">Salvar código</button></div></form></section><section class="section"><div class="section-head"><h2>Controle médico</h2><button class="btn small" data-action="notifications">🔔 Notificações</button></div>${summaryTable()}</section><section class="section"><div class="section-head"><h2>Escala pública do mês</h2></div>${calendar(false)}</section>`;}
function summaryTable(){const rows=state.data.summaries||[];return `<div class="table-wrap"><table class="table"><thead><tr><th>Médico</th><th>Carga prevista</th><th>Atestado</th><th>%</th><th>Limite 25%</th><th>Dívida</th><th>Pago</th><th>Saldo</th><th>Extras</th></tr></thead><tbody>${rows.map(x=>`<tr><td><b>${esc(x.name)}</b></td><td>${x.plannedHours}h</td><td>${x.attestationHours}h</td><td><span class="chip ${x.attestationPercent>=25?'red':x.attestationPercent>=20?'yellow':'green'}">${x.attestationPercent}%</span></td><td>${x.attestationLimitHours}h</td><td>${x.debtHours}h</td><td>${x.paidHours}h</td><td><b>${x.balanceHours}h</b></td><td>${x.extraHours}h</td></tr>`).join('')}</tbody></table></div>`;}
