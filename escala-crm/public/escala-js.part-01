function topbar(){if(!state.session)return `<header class="topbar"><div class="brand"><span class="brand-dot"></span><div><strong>CRS Coophavila</strong><small>Escala médica online</small></div></div><div class="top-actions"><span class="badge">Acesso compartilhado</span></div></header>`;let nav=[];if(state.session.role==='admin')nav=[['dashboard','Painel'],['schedule','Escala'],['templates','Padrão'],['doctors','Médicos'],['requests','Solicitações'],['audit','Auditoria']];else if(state.session.role==='doctor')nav=[['mine','Meu painel'],['public','Escala pública'],['requests','Solicitações']];else nav=[['public','Escala pública']];const action=state.session.role==='doctor'?`<button class="btn small ghost" data-action="unidentify">Trocar CRM</button><button class="btn small ghost" data-action="logout">Sair</button>`:`<button class="btn small ghost" data-action="logout">Sair</button>`;return `<header class="topbar"><div class="brand"><span class="brand-dot"></span><div><strong>CRS Coophavila</strong><small>Escala médica online</small></div></div><nav class="nav">${nav.map(([r,l])=>`<button class="${state.route===r?'active':''}" data-route="${r}">${l}</button>`).join('')}</nav><div class="top-actions"><span class="badge">${esc(state.session.role==='viewer'?'Acesso da unidade':state.session.name||state.session.role)}</span>${action}</div></header><div class="mobile-tabs">${nav.map(([r,l])=>`<button class="${state.route===r?'active':''}" data-route="${r}">${l}</button>`).join('')}</div>`;}
function monthbar(){return `<div class="monthbar"><button class="btn small" data-month="-1">←</button><strong>${esc(monthLabel(state.month))}</strong><button class="btn small" data-month="1">→</button></div>`;}
function shiftCard(s,admin=false){const doc=state.data.doctors?.[s.doctorId]||state.data.doctorsList?.find(d=>d.id===s.doctorId)||{name:'Médico'};return `<div class="shift ${s.category==='pagamento'?'payment':s.category==='eventual'?'eventual':''}"><div class="name">${esc(doc.name)}</div><div class="meta">${esc(FN[s.function]||s.function)} · ${esc(s.start)}–${esc(s.end)} · ${s.hours}h</div><span class="chip ${s.category==='pagamento'?'purple':s.category==='eventual'?'yellow':'green'}">${esc(CAT[s.category]||s.category)}</span>${admin?`<div style="margin-top:5px"><button class="btn small" data-shift-replace="${s.id}">Substituir</button> <button class="btn small danger" data-shift-remove="${s.id}">Remover</button></div>`:''}</div>`;}
function calendar(admin=false){const [y,m]=state.month.split('-').map(Number),days=new Date(y,m,0).getDate(),list=state.data?.shifts||[];let html='';for(let d=1;d<=days;d++){const date=`${state.month}-${String(d).padStart(2,'0')}`,dateObj=new Date(`${date}T00:00:00Z`),shifts=list.filter(s=>s.date===date),used=shifts.filter(s=>s.category!=='fixo').reduce((a,s)=>a+Number(s.hours),0),avail=Math.max(0,96-used);html+=`<div class="day-card ${shifts.length?'':'empty'}"><div class="day-top"><div><div class="date-num">${d}</div><div class="muted" style="font-size:11px">${DAYS[dateObj.getUTCDay()]}</div></div><div class="extra-meter"><strong>${avail}h disponíveis</strong>${used}h / 96h extras</div></div>${shifts.map(s=>shiftCard(s,admin)).join('')||'<div class="muted" style="font-size:12px">Sem plantonistas lançados</div>'}</div>`;}return `<div class="calendar-grid">${html}</div>`;}
function publicView(){const identify=state.session?.role==='viewer'?`<section class="card"><h2>Precisa fazer uma solicitação?</h2><p class="muted">Identifique-se apenas com seu CRM de 5 dígitos. O CRM é usado para autoria das solicitações; o acesso à escala continua compartilhado.</p><form id="identify-form" class="form-grid"><div class="field"><label>CRM</label><input name="crm" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" placeholder="00000" required></div><div class="field"><label>&nbsp;</label><button class="btn primary" type="submit">Identificar e continuar</button></div></form></section>`:'';return `<div class="hero"><div><div class="eyebrow">Escala compartilhada</div><h1>Escala médica</h1><p>Visualização diária da escala efetiva da CRS Coophavila. Cada dia mostra também a disponibilidade restante para lançamentos extras dentro do limite de 96 horas.</p></div>${monthbar()}</div>${identify}${calendar(false)}`;}
