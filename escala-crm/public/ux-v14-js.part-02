xtShiftHero(next){
    if(!next)return `<section class="ux-next-shift empty"><div class="eyebrow">Próximo plantão</div><h2>Nenhum plantão futuro encontrado</h2><p>Consulte a escala completa para verificar o mês.</p><button class="btn primary" data-route="public">Ver minha escala</button></section>`;
    const st=shiftState(next);const when=isToday(next.date)?'Hoje':next.date===tomorrowDate()?'Amanhã':fmtDate(next.date);
    return `<section class="ux-next-shift"><div class="ux-next-copy"><div class="eyebrow">Próximo plantão</div><h2>${when}</h2><div class="ux-next-time">${esc(next.start)}–${esc(next.end)}</div><p>${esc(FN[next.function]||next.function)} · ${next.hours}h</p><span class="ux-status ${st.cls}">${st.label}</span></div><button class="btn primary ux-big-action" data-route="public">Ver minha escala</button></section>`;
  }
  mineView=function(){
    const future=futureOwnShifts();const next=future[0];const recent=(state.data?.myRequests||[]).slice().sort((a,b)=>String(b.submittedAt||'').localeCompare(String(a.submittedAt||''))).slice(0,3);const sum=state.data?.mySummary||{};
    return `<div class="ux-home-head"><div><div class="eyebrow">Área do médico · Coophavila</div><h1>Olá, ${esc(state.session.name)}</h1><p>Seu próximo plantão, sua carga do mês e seus limites aparecem primeiro.</p></div></div><section class="ux-doctor-snapshot"><div><span>Plantões previstos</span><strong>${sum.plannedShifts||0}</strong><small>${sum.plannedHours||0}h no mês</small></div><div><span>Atestado</span><strong>${sum.attestationHours||0}h</strong><small>de ${sum.attestationLimitHours||0}h permitidas (25%)</small></div><div><span>Ainda disponível</span><strong>${sum.attestationRemainingHours||0}h</strong><small>sem ultrapassar 25%</small></div><div><span>Extras Coophavila</span><strong>${sum.extraHours||0}h</strong><small>${sum.extraShifts||0} plantões · ${sum.extraEquivalent12h||0} de ${sum.extraEquivalentLimit||14} equivalentes de 12h</small></div></section>${nextShiftHero(next)}${future.length>1?`<section class="ux-upcoming"><div class="ux-section-title"><h2>Próximos plantões</h2></div><div class="ux-upcoming-grid">${future.slice(1,4).map(s=>`<div class="ux-upcoming-card"><strong>${fmtDate(s.date)}</strong><span>${s.start}–${s.end}</span><small>${esc(FN[s.function]||s.function)}</small></div>`).join('')}</div></section>`:''}${requestHub()}<section class="ux-recent"><div class="ux-section-title"><h2>Minhas solicitações</h2><button class="btn small" type="button" data-ux-show-all-requests>Ver todas</button></div>${recent.map(recentRequestCard).join('')||'<div class="card ux-empty">Você ainda não fez solicitações.</div>'}</section>`;
  };

  function doctorAreaView(){
    const sum=state.data?.mySummary||{};const all=currentDoctorShifts();const done=all.filter(isPastShift);
    const freqClass=(sum.attendancePercent||0)>=75?'ok':'bad';const attClass=sum.attestationWithinLimit===false?'bad':'ok';
    return `<div class="hero ux-hero-compact"><div><div class="eyebrow">Minha área · Coophavila</div><h1>Frequência e plantões</h1><p>O limite de ausência por atestado é calculado sobre as horas previstas reais deste mês.</p></div>${monthbar()}</div><div class="ux-month-grid"><div class="metric"><small>Plantões previstos</small><div class="num">${sum.plannedShifts||0}</div><span>${sum.plannedHours||0}h previstas</span></div><div class="metric"><small>Carga própria mantida</small><div class="num">${sum.keptHours||0}h</div><span class="ux-status ${freqClass}">${sum.attendancePercent??0}% da carga</span></div><div class="metric"><small>Mínimo obrigatório</small><div class="num">${sum.minimumAttendanceHours||0}h</div><span>75% das horas previstas</span></div><div class="metric"><small>Atestado usado</small><div class="num">${sum.attestationHours||0}h</div><span>${sum.attestationCount||0} ocorrência(s)</span><span class="ux-status ${attClass}">${sum.attestationPercent||0}% de 25%</span></div><div class="metric"><small>Atestado ainda disponível</small><div class="num">${sum.attestationRemainingHours||0}h</div><span>teto: ${sum.attestationLimitHours||0}h</span></div><div class="metric"><small>Horas a compensar</small><div class="num">${sum.balanceHours||0}h</div></div><div class="metric"><small>Extras Coophavila</small><div class="num">${sum.extraHours||0}h</div><span>${sum.extraShifts||0} plantões realizados</span></div><div class="metric"><small>Equivalentes de 12h</small><div class="num">${sum.extraEquivalent12h||0} / ${sum.extraEquivalentLimit||14}</div><span>6h = 0,5 · 12h = 1</span></div></div><section class="section"><div class="ux-section-title"><h2>Plantões já realizados neste mês</h2></div>${done.slice().sort((a,b)=>(b.date+b.start).localeCompare(a.date+a.start)).map(s=>`<div class="ux-history-row"><div><strong>${fmtDate(s.date)} · ${s.start}–${s.end}</strong><span>${esc(FN[s.function]||s.function)} · ${s.hours}h · ${s.category==='fixo'?'escala regular':'extra Coophavila'}</span></div><span class="ux-status ok">REALIZADO</span></div>`).join('')||'<div class="card ux-empty">Nenhum plantão realizado neste mês.</div>'}</section>`;
  }

  function chooseRequestShift(type){
    const shifts=futureOwnShifts();const title={passagem:'Qual plantão você precisa passar?',troca:'Qual plantão você quer trocar?',atestado:'Qual plantão o atestado afeta?',ausencia:'Qual plantão será afetado?',pagamento:'Qual plantão está relacionado ao pagamento?'}[type]||'Escolha o plantão';
    return `<section class="card ux-flow-card"><button class="ux-back-link" type="button" data-ux-request-back>← Voltar</button><div class="eyebrow">Passo 1</div><h2>${title}</h2><p class="muted">Mostramos somente seus plantões futuros elegíveis.</p><div class="ux-shift-picker">${shifts.map(s=>`<button type="button" data-ux-pick-shift="${s.id}" data-ux-pick-type="${type}"><strong>${fmtDate(s.date)} · ${s.start}–${s.end}</strong><span>${esc(FN[s.function]||s.function)} · ${s.hours}h</span></button>`).join('')||'<div class="ux-empty">Nenhum plantão futuro elegível.</div>'}</div></section>`;
  }

  newRequestForm=function(){
    const d=state.requestDraft;if(!d)return '';const s=(state.data?.shifts||[]).find(x=>x.id===d.shiftId);if(!s)return '';
    const docs=doctors().filter(x=>x.id!==state.session.id);
    const target=d.type==='troca'?`<div class="ux-step-block"><div class="ux-step-number">2</div><div class="ux-step-content"><h3>Com quem será a troca?</h3><label class="field"><span>Médico envolvido</span><select name="targetDoctorId" required><option value="">Selecione o médico</option>${docs.map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join('')}</select></label></div></div>`:d.type==='ausencia'?`<div class="ux-step-block"><div class="ux-step-number">2</div><div class="ux-step-content"><h3>Já existe substituto?</h3><label class="field"><span>Médico substituto (opcional)</span><select name="targetDoctorId"><option value="">Ainda não definido</option>${docs.map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join('')}</select></label></div></div>`:'';
    const attestation=d.type==='atestado'?`<div class="ux-step-block"><div class="ux-step-number">2</div><div class="ux-step-content"><h3>Período do atestado</h3><div class="ux-period-grid"><label class="field"><span>De</span><input type="date" name="pe