riodStart" value="${s.date}" required></label><label class="field"><span>Até</span><input type="date" name="periodEnd" value="${s.date}" required></label></div><h3>Documento</h3><div class="ux-upload-grid"><label class="ux-upload-button">Tirar foto<input class="visually-hidden" type="file" name="cameraFile" accept="image/*" capture="environment"></label><label class="ux-upload-button">Escolher arquivo<input class="visually-hidden" type="file" name="file" accept="application/pdf,image/jpeg,image/png,image/webp"></label></div><div class="ux-file-name" data-ux-file-name>Nenhum arquivo selecionado</div></div></div>`:'';
    return `<section class="card ux-guided-request"><button class="ux-back-link" type="button" data-ux-request-back>← Voltar</button><div class="eyebrow">${esc(TYPE[d.type])}</div><div class="ux-step-block"><div class="ux-step-number">1</div><div class="ux-step-content"><h3>Plantão selecionado</h3><div class="ux-review-box"><strong>${fmtDate(s.date)} · ${s.start}–${s.end}</strong><span>${esc(FN[s.function]||s.function)} · ${s.hours}h</span></div></div></div><form id="request-form"><input type="hidden" name="type" value="${d.type}"><input type="hidden" name="shiftId" value="${s.id}"><input type="hidden" name="eventDate" value="${s.date}"><input type="hidden" name="hours" value="${s.hours}">${target}${attestation}<div class="ux-step-block"><div class="ux-step-number">${d.type==='troca'||d.type==='ausencia'||d.type==='atestado'?3:2}</div><div class="ux-step-content"><h3>Revisar e enviar</h3><label class="field"><span>Observação (opcional)</span><textarea name="notes" placeholder="Somente se houver alguma informação adicional"></textarea></label><div class="ux-confirm-note">A escala oficial só será alterada depois da decisão do gestor.</div><div class="actions ux-form-actions"><button class="btn primary ux-big-action" type="submit">Confirmar solicitação</button><button class="btn" type="button" data-action="cancel-request">Cancelar</button></div></div></div></form></section>`;
  };

  function requestTimeline(r){
    const sent=`<div><span></span><p><strong>Solicitação enviada</strong><small>${fmtTs(r.submittedAt)}</small></p></div>`;
    let middle='';if(r.status==='pending_peer')middle=`<div><span></span><p><strong>Aguardando o médico envolvido</strong><small>A escala permanece sem alteração.</small></p></div>`;else if(r.status==='pending_admin')middle=`<div><span></span><p><strong>Médico envolvido aceitou</strong><small>Aguardando decisão do gestor.</small></p></div>`;
    const end=['approved','rejected'].includes(r.status)?`<div><span></span><p><strong>${r.status==='approved'?'Gestor aprovou':'Gestor não aprovou'}</strong><small>${r.decidedAt?fmtTs(r.decidedAt):statusLabel(r.status)}</small></p></div>`:'';
    return `<div class="ux-timeline">${sent}${middle}${end}</div>`;
  }

  doctorRequests=function(){
    const rows=(state.data?.myRequests||[]).slice().sort((a,b)=>String(b.submittedAt||'').localeCompare(String(a.submittedAt||'')));
    let flow='';if(state.requestDraft)flow=newRequestForm();else if(state.uxRequestType)flow=chooseRequestShift(state.uxRequestType);else flow=requestHub();
    const success=state.uxLastSubmission?`<section class="ux-success-card"><div><div class="eyebrow">${esc(TYPE[state.uxLastSubmission.type]||'Solicitação')} enviada</div><h2>Recebido com sucesso</h2><p>Recebido em ${fmtTs(state.uxLastSubmission.submittedAt)} · Protocolo ${esc(state.uxLastSubmission.protocol)}</p><span class="ux-status warn">${statusLabel(state.uxLastSubmission.status)}</span></div><button class="btn" type="button" data-ux-dismiss-success>Fechar</button></section>`:'';
    return `<div class="hero ux-hero-compact"><div><div class="eyebrow">Solicitações</div><h1>${state.requestDraft||state.uxRequestType?'Nova solicitação':'Solicitar e acompanhar'}</h1><p>Escolha uma tarefa. O sistema mostra somente as etapas necessárias.</p></div></div>${success}${flow}<section class="section"><div class="ux-section-title"><h2>Minhas solicitações</h2></div>${rows.map(r=>`<div class="ux-request-card"><div><strong>${esc(TYPE[r.type]||r.type)}</strong><span>${fmtDate(r.eventDate)} · ${r.hours}h</span>${requestTimeline(r)}${r.decisionNote?`<small>Observação da decisão: ${esc(r.decisionNote)}</small>`:''}</div>${requestStatusPill(r)}${r.type==='troca'&&r.targetDoctorId===state.session.id&&r.status==='pending_peer'?`<div class="actions"><button class="btn good" data-peer="${r.id}" data-accept="1">Aceitar troca</button><button class="btn danger" data-peer="${r.id}" data-accept="0">Não aceitar</button></div>`:''}</div>`).join('')||'<div class="card ux-empty">Nenhuma solicitação.</div>'}</section>`;
  };

  function intervalForShift(s){const start=new Date(`${s.date}T${s.start}:00-04:00`);let end=new Date(`${s.date}T${s.end}:00-04:00`);if(end<=start)end=new Date(end.getTime()+86400000);return [start,end];}
  function overlaps(a,b){const [as,ae]=intervalForShift(a),[bs,be]=intervalForShift(b);return as<be&&bs<ae;}
  function requestImpact(r){
    const shift=(state.data?.shifts||[]).find(s=>s.id===(r.shiftId||r.shift_id));if(!shift)return {text:'Plantão vinculado não está ativo na escala atual.',cls:'warn'};
    const targetId=r.targetDoctorId||r.target_doctor_id;if(!targetId)return {text:r.type==='troca'?'Selecione um substituto antes de aprovar.':'Nenhum substituto definido.',cls:'warn'};
    const conflicts=(state.data?.shifts||[]).filter(s=>s.doctorId===targetId&&s.id!==shift.id&&overlaps(shift,s));
    return conflicts.length?{text:`ATENÇÃO: ${doctorById(targetId)?.name||'Médico'} já possui plantão com conflito de horário.`,cls:'bad'}:{text:'Nenhum conflito de horário encontrado para o substituto indicado.',cls:'ok'};
  }
  function requestAdminCardV14(r){
    const d=doctorById(r.doctorId),target=