doctorById(r.targetDoctorId);const pending=PENDING_STATUSES.has(r.status);const impact=requestImpact(r);const canReplace=['troca','atestado','ausencia'].includes(r.type);
    const replacement=pending&&canReplace?`<div class="ux-admin-fields"><label>Substituto efetivo<select data-request-target="${r.id}"><option value="">Sem substituto definido</option>${doctors().filter(x=>x.id!==r.doctorId).map(x=>`<option value="${x.id}" ${x.id===r.targetDoctorId?'selected':''}>${esc(x.name)}</option>`).join('')}</select></label><label>Tipo do substituto<select data-request-category="${r.id}"><option value="eventual" ${r.category==='eventual'?'selected':''}>Eventual</option><option value="pagamento" ${r.category==='pagamento'?'selected':''}>Pagamento de horas</option><option value="fixo" ${r.category==='fixo'?'selected':''}>Fixo</option></select></label></div>`:'';
    return `<article class="ux-admin-request"><div class="ux-admin-request-head"><div><div class="eyebrow">${esc(TYPE[r.type]||r.type)}</div><h3>${esc(d?.name||'Médico')}</h3><p>${fmtDate(r.eventDate)} · ${r.hours}h · protocolo ${esc(r.protocol)}</p></div>${requestStatusPill(r)}</div>${target?`<div class="ux-detail-line"><span>Substituto indicado</span><strong>${esc(target.name)}</strong></div>`:''}${r.notes?`<div class="ux-detail-line"><span>Observação</span><strong>${esc(r.notes)}</strong></div>`:''}${r.attachment?`<a class="btn" href="/api/requests/${r.id}/attachment" target="_blank" rel="noopener">Ver documento</a>`:''}${pending&&['troca','atestado','ausencia'].includes(r.type)?`<div class="ux-impact ${impact.cls}"><strong>Impacto</strong><span>${esc(impact.text)}</span></div>`:''}${replacement}<div class="ux-admin-request-actions">${pending?`${r.type==='ausencia'?`<button class="btn good" data-decide="${r.id}" data-debt="1">Aprovar + horas pendentes</button><button class="btn" data-decide="${r.id}" data-debt="0">Aprovar sem horas pendentes</button>`:`<button class="btn good" data-decide="${r.id}" data-approve="1">Aprovar</button>`}<button class="btn danger" data-decide="${r.id}" data-approve="0">Não aprovar</button>`:''}</div></article>`;
  }
  requestAdminCard=requestAdminCardV14;
  requestsView=function(){
    if(state.session.role==='doctor')return doctorRequests();const rows=(state.data?.requests||[]).slice().sort((a,b)=>{const pa=PENDING_STATUSES.has(a.status)?0:1,pb=PENDING_STATUSES.has(b.status)?0:1;return pa-pb||String(b.submittedAt||'').localeCompare(String(a.submittedAt||''));});
    return `<div class="hero ux-hero-compact"><div><div class="eyebrow">Central de pendências</div><h1>Solicitações</h1><p>Pendências primeiro. A escala oficial só muda depois de uma decisão registrada.</p></div></div>${rows.map(requestAdminCardV14).join('')||'<div class="card ux-empty">Nenhuma solicitação.</div>'}`;
  };

  dashboard=function(){
    const rows=state.data?.requests||[];const pending=rows.filter(r=>PENDING_STATUSES.has(r.status));const count=t=>pending.filter(r=>r.type===t).length;const today=doctorNowDate();const todayShifts=(state.data?.shifts||[]).filter(s=>s.date===today);const todayPending=pending.filter(r=>r.eventDate===today);const uncovered=rows.filter(r=>r.eventDate===today&&r.status==='approved'&&['atestado','ausencia'].includes(r.type)&&!(r.targetDoctorId||r.target_doctor_id)&&!(state.data?.shifts||[]).some(s=>s.id===(r.shiftId||r.shift_id))).length;const scheduledDoctors=new Set(todayShifts.map(s=>s.doctorId).filter(Boolean));const pendingShiftIds=new Set(todayPending.map(r=>r.shiftId||r.shift_id).filter(Boolean));const pendingDoctors=new Set(todayShifts.filter(s=>pendingShiftIds.has(s.id)).map(s=>s.doctorId).filter(Boolean));const without=Math.max(0,scheduledDoctors.size-pendingDoctors.size);
    return `<div class="hero ux-hero-compact"><div><div class="eyebrow">Gestão por exceção</div><h1>O que precisa da minha atenção?</h1><p>O trabalho normal não exige confirmação. Aqui aparecem somente pendências e exceções.</p></div>${monthbar()}</div><div class="ux-pending-grid"><button data-route="requests"><span>Trocas aguardando análise</span><strong>${count('troca')}</strong></button><button data-route="requests"><span>Atestados novos</span><strong>${count('atestado')}</strong></button><button data-route="requests"><span>Ausências</span><strong>${count('ausencia')}</strong></button><button data-route="requests"><span>Outras pendências</span><strong>${pending.filter(r=>!['troca','atestado','ausencia'].includes(r.type)).length}</strong></button></div><section class="ux-today-card"><div class="ux-section-title"><div><div class="eyebrow">Escala de hoje</div><h2>${fmtDate(today)}</h2></div><button class="btn" data-route="schedule">Ver escala completa</button></div><div class="ux-today-metrics"><div><span>Médicos escalados</span><strong>${scheduledDoctors.size}</strong></div><div><span>Sem pendências</span><strong>${without}</strong></div><div><span>Alterações em análise</span><strong>${todayPending.length}</strong></div><div><span>Plantões descobertos</span><strong>${uncovered}</strong></div></div>${todayShifts.length?scheduleListForToday(todayShifts):'<div class="ux-empty">Nenhum plantão lançado para hoje.</div>'}</section>`;
  };
  function scheduleListForToday(list){return `<div class="ux-schedule-list compact">${list.sort((a,b)=>String(a.start).localeCompare(String(b.start))).map(s=>shiftLine(s,false)).join('')}</div>`;}

  scheduleAdmin=function(){
    return `<div class="hero ux-hero-compact"><div><div class="eyebrow">Escala</div><h1>Escala mensal</h1><p>Todo médico presente na escala está escalado por padrão. Altere apenas quando houver uma exceção real.</p></div>${monthbar()}</div>${scheduleToolbar(true)}${state.uxScheduleMode==='list'?scheduleList(true):renderCalendarFiltered(true)}<details class="card ux-admin-tools"><summary>