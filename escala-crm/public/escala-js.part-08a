function doctorsView(){const rows=state.data.doctorsList||[];return `<div class="hero"><div><div class="eyebrow">Cadastro médico</div><h1>Médicos</h1><p>Cadastre nome completo, CRM e vínculo. Inativar preserva todo o histórico e remove o médico dos novos lançamentos.</p></div></div><section class="card"><h2>Novo médico</h2><form id="doctor-form" class="form-grid"><div class="field"><label>Nome completo</label><input name="name" required></div><div class="field"><label>CRM</label><input name="crm" inputmode="numeric" pattern="[0-9]{4,5}" maxlength="5" placeholder="Somente números" required><small>4 ou 5 dígitos, somente números.</small></div><div class="field"><label>Categoria</label><select name="doctorType"><option value="folha">Médico de folha</option><option value="extra">Plantonista extra</option></select></div><div class="field"><label>&nbsp;</label><button class="btn primary" type="submit">Cadastrar médico</button></div></form></section><section class="section"><div class="table-wrap"><table class="table"><thead><tr><th>Médico</th><th>CRM</th><th>Categoria</th><th>Status</th><th>Ações</th></tr></thead><tbody>${rows.map(d=>`<tr><td><b>${esc(d.name)}</b></td><td>${esc(d.crm||'—')}</td><td><select data-doctor-type="${d.id}"><option value="folha" ${d.doctorType==='folha'?'selected':''}>Médico de folha</option><option value="extra" ${d.doctorType==='extra'?'selected':''}>Plantonista extra</option></select></td><td><span class="chip ${d.active?'green':'red'}">${d.active?'Ativo':'Inativo'}</span></td><td><button class="btn small" data-reset-crm="${d.id}">Alterar CRM</button> <button class="btn small ${d.active?'danger':'good'}" data-doctor-status="${d.id}" data-active="${d.active?'0':'1'}">${d.active?'Inativar':'Reativar'}</button></td></tr>`).join('')}</tbody></table></div></section>`;}
function summaryTable(){const rows=state.data.summaries||[];return `<div class="table-wrap"><table class="table"><thead><tr><th>Médico</th><th>Plantões folha</th><th>Carga prevista</th><th>Atestados</th><th>% atestado</th><th>Limite 25%</th><th>Horas a compensar</th><th>Compensadas/pagas</th><th>Horas pendentes</th><th>Extras</th><th>Situação</th></tr></thead><tbody>${rows.map(x=>{const badDebt=Number(x.balanceHours)>0,badAtt=Number(x.attestationPercent)>=25,status=badDebt?'HORAS PENDENTES':badAtt?'ATESTADO ≥ 25%':'OK';return `<tr><td><b>${esc(x.name)}</b><br><small>CRM ${esc(x.crm||'—')}</small></td><td>${x.plannedShifts||0}</td><td>${x.plannedHours}h</td><td>${x.attestationHours}h</td><td><span class="chip ${badAtt?'red':x.attestationPercent>=20?'yellow':'green'}">${x.attestationPercent}%</span></td><td>${x.attestationLimitHours}h</td><td>${x.debtHours}h</td><td>${x.paidHours}h</td><td><b class="${badDebt?'kpi-alert':''}">${x.balanceHours}h</b></td><td>${x.extraHours}h</td><td><span class="chip ${badDebt||badAtt?'red':'green'}">${status}</span></td></tr>`}).join('')}</tbody></table></div>`;}
function adminRecentNotifications(){const rows=(state.data.notifications||[]).slice(0,8);return `<section class="card section"><div class="section-head"><div><h2>Central de notificações</h2><p class="muted">Demandas recentes com data e hora do servidor. Marque como conferido após revisar.</p></div><button class="btn small" data-action="notifications">Ver todas</button></div>${rows.map(n=>`<div class="notice ${n.read_at?'':'unread'}"><div><strong>${esc(n.title)}</strong><div>${esc(n.body)}</div><small>${fmtTs(new Date(Number(n.created_at)).toISOString())}</small></div><div>${n.read_at?'<span class="chip green">✓ Conferido</span>':`<button class="btn small good" data-notif-read="${n.id}">✓ Marcar conferido</button>`}</div></div>`).join('')||'<div class="muted">Nenhuma demanda recente.</div>'}</section>`;}
function dashboard(){const s=state.data.summaries||[],pending=(state.data.requests||[]).filter(r=>['pending','pending_peer','pending_admin'].includes(r.status)).length,near=s.filter(x=>x.attestationPercent>=20&&x.attestationPercent<25).length,over=s.filter(x=>x.attestationPercent>=25).length,withDebt=s.filter(x=>Number(x.balanceHours)>0).length,unread=(state.data.notifications||[]).filter(n=>!n.read_at).length;return `<div class="hero"><div><div class="eyebrow">Administração</div><h1>Painel da escala</h1><p>Fechamento mensal dos médicos de folha, solicitações e pendências em tempo real.</p></div>${monthbar()}</div><div class="grid metrics"><div class="metric"><small>Solicitações pendentes</small><div class="num">${pending}</div></div><div class="metric"><small>Não conferidas</small><div class="num">${unread}</div></div><div class="metric"><small>Horas pendentes</small><div class="num ${withDebt?'kpi-alert':''}">${withDebt}</div></div><div class="metric"><small>Atestado ≥ 25%</small><div class="num ${over?'kpi-alert':''}">${over}</div></div></div>${adminRecentNotifications()}<section class="section"><div class="section-head"><div><h2>Fechamento mensal — médicos de folha</h2><p class="muted">O fechamento só é considerado regular quando não houver horas pendentes e o percentual de atestados permanecer abaixo de 25%.</p></div><div><button class="btn small" data-export="excel">Exportar Excel</button> <button class="btn small" data-export="pdf">Gerar PDF</button></div></div>${summaryTable()}</section><section class="card"><h2>Acesso compartilhado da equipe</h2><form id="unit-access-form" class="form-grid"><div class="field"><label>Novo código da unidade</label><input name="accessCode" type="password" minlength="4" required></div><div class="field"><label>&nbsp;</label><button class="btn" type="submit">Salvar código</button></div></form></section><section class="section"><div class="section-head"><h2>Escala pública do mês</h2></div>${calendar(false)}</section>`;}
function notificationsView(){const rows=state.data.notifications||[];return `<div class="hero"><div><div class="eyebrow">Administração</div><h1>Central de notificações</h1><p>Trocas, atestados, pagamentos, ausências e extras, sempre com registro de data e hora.</p></div><button class="btn" data-action="enable-notifications">Ativar notificações do navegador</button></div>${rows.map(n=>`<div class="notice ${n.read_at?'':'unread'}"><div><strong>${esc(n.title)}</strong><div>${esc(n.body)}</div><small>${fmtTs(new Date(Number(n.created_at)).toISOString())}</small></div><div>${n.read_at?'<span class="chip green">✓ Conferido</span>':`<button class="btn small good" data-notif-read="${n.id}">✓ Marcar conferido</button>`}</div></div>`).join('')||'<div class="card muted">Nenhuma notificação.</div>'}`;}
function exportMonthlyExcel(){const rows=state.data.summaries||[],head=['Médico','CRM','Plantões de folha','Carga prevista (h)','Atestados (h)','Atestados (%)','Limite 25% (h)','Horas a compensar','Horas compensadas/pagas','Horas pendentes','Extras (h)','Situação'];const data=rows.map(x=>[x.name,x.crm||'',x.plannedShifts||0,x.plannedHours,x.attestationHours,x.attestationPercent,x.attestationLimitHours,x.debtHours,x.paidHours,x.balanceHours,x.extraHours,Number(x.balanceHours)>0?'HORAS PENDENTES':Number(x.attestationPercent)>=25?'ATESTADO >= 25%':'OK']);const escXml=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');const rowXml=r=>`<Row>${r.map(v=>`<Cell><Data ss:Type="String">${escXml(v)}</Data></Cell>`).join('')}</Row>`;const xml=`<?xml version="1.0"?><Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"><Worksheet ss:Name="Fechamento ${state.month}"><Table>${rowXml(head)}${data.map(rowXml).join('')}</Table></Worksheet></Workbook>`;downloadBlob(new Blob([xml],{type:'application/vnd.ms-excel'}),`fechamento-escala-${state.month}.xls`);}
function exportMonthlyPdf(){const rows=state.data.summaries||[],table=`<table><thead><tr><th>Médico</th><th>CRM</th><th>Plantões</th><th>Carga</th><th>Atestados</th><th>%</th><th>Limite 25%</th><th>Pendente</th><th>Extras</th><th>Situação</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${esc(x.name)}</td><td>${esc(x.crm||'')}</td><td>${x.plannedShifts||0}</td><td>${x.plannedHours}h</td><td>${x.attestationHours}h</td><td>${x.attestationPercent}%</td><td>${x.attestationLimitHours}h</td><td>${x.balanceHours}h</td><td>${x.extraHours}h</td><td>${Number(x.balanceHours)>0?'HORAS PENDENTES':Number(x.attestationPercent)>=25?'ATESTADO ≥ 25%':'OK'}</td></tr>`).join('')}</tbody></table>`;const w=window.open('','_blank');w.document.write(`<html><head><title>Fechamento ${state.month}</title><style>body{font-family:Arial;padding:24px}h1{font-size:22px}table{border-collapse:collapse;width:100%;font-size:11px}th,td{border:1px solid #999;padding:6px;text-align:left}th{background:#eee}</style></head><body><h1>CRS Coophavila — Fechamento mensal ${state.month}</h1><p>Médicos de folha. Critérios: horas pendentes = 0; atestados abaixo de 25% da carga prevista.</p>${table}</body></html>`);w.document.close();setTimeout(()=>w.print(),300);}
function downloadBlob(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},500);}
document.addEventListener('change',async e=>{const id=e.target?.dataset?.doctorType;if(!id)return;try{await post(`/api/admin/doctors/${id}/type`,{doctorType:e.target.value});toast('Categoria do médico atualizada.');await load();}catch(err){toast(err.message,true)}});
document.addEventListener('click',async e=>{const status=e.target.closest?.('[data-doctor-status]');if(status){const active=status.dataset.active==='1';if(!confirm(active?'Reativar este médico?':'Inativar este médico? O histórico será preservado.'))return;try{await post(`/api/admin/doctors/${status.dataset.doctorStatus}/status`,{active});toast(active?'Médico reativado.':'Médico inativado.');await load();}catch(err){toast(err.message,true)}return;}const ex=e.target.closest?.('[data-export]');if(ex){if(ex.dataset.export==='excel')exportMonthlyExcel();else exportMonthlyPdf();}});
