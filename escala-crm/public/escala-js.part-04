function doctorsView(){return `<div class="hero"><div><div class="eyebrow">Identificação</div><h1>Médicos</h1><p>Cadastre nome e CRM. Para o uso diário, o médico entra na escala com o código compartilhado e informa o CRM apenas quando precisar realizar uma ação individual.</p></div></div><section class="card"><h2>Novo médico</h2><form id="doctor-form" class="form-grid"><div class="field"><label>Nome</label><input name="name" required></div><div class="field"><label>CRM (5 dígitos)</label><input name="crm" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" placeholder="00000" required></div><div class="field"><label>&nbsp;</label><button class="btn primary" type="submit">Cadastrar médico</button></div></form></section><section class="section"><div class="table-wrap"><table class="table"><thead><tr><th>Médico</th><th>CRM</th><th>Status</th><th>Ações</th></tr></thead><tbody>${(state.data.doctorsList||[]).map(d=>`<tr><td><b>${esc(d.name)}</b></td><td>${esc(d.crm||'—')}</td><td>${d.active?'Ativo':'Inativo'}</td><td><button class="btn small" data-reset-crm="${d.id}">Alterar CRM</button></td></tr>`).join('')}</tbody></table></div></section>`;}
function requestsView(){if(state.session.role==='doctor')return doctorRequests();const rows=state.data.requests||[];return `<div class="hero"><div><div class="eyebrow">Administração</div><h1>Solicitações</h1><p>Decisões registradas com horário do servidor e trilha de auditoria.</p></div><button class="btn" data-action="notifications">🔔 Notificações</button></div>${rows.map(requestAdminCard).join('')||'<div class="card muted">Nenhuma solicitação.</div>'}`;}
function requestAdminCard(r){const d=state.data.doctorsList.find(x=>x.id===r.doctorId),target=state.data.doctorsList.find(x=>x.id===r.targetDoctorId);return `<div class="request-card"><div><h3>${esc(TYPE[r.type])} · ${esc(r.protocol)}</h3><p><b>${esc(d?.name||'Médico')}</b> · fato em ${fmtDate(r.eventDate)} · ${r.hours}h ${r.retroactive?'· RETROATIVO':''}</p>${target?`<p>Substituto: ${esc(target.name)} · ${esc(CAT[r.category]||r.category)}</p>`:''}<p>Enviado: ${fmtTs(r.submittedAt)} · <span class="status ${r.status}">${esc(r.status)}</span></p>${r.retroReason?`<p>Motivo retroativo: ${esc(r.retroReason)}</p>`:''}${r.notes?`<p>${esc(r.notes)}</p>`:''}${r.attachment?`<p><a class="btn small" href="/api/requests/${r.id}/attachment" target="_blank">Abrir documento</a></p>`:''}</div><div class="actions">${['pending','pending_admin'].includes(r.status)?`${r.type==='ausencia'?`<button class="btn good small" data-decide="${r.id}" data-debt="1">Aprovar + dívida</button><button class="btn small" data-decide="${r.id}" data-debt="0">Aprovar sem dívida</button>`:`<button class="btn good small" data-decide="${r.id}" data-approve="1">Aprovar</button>`}<button class="btn danger small" data-decide="${r.id}" data-approve="0">Recusar</button>`:''}</div></div>`;}
function doctorRequests(){const rows=state.data.myRequests||[];return `<div class="hero"><div><div class="eyebrow">Meu acesso</div><h1>Solicitações</h1><p>Envie uma nova solicitação e acompanhe o protocolo em tempo real.</p></div><button class="btn primary" data-action="new-request">+ Nova solicitação</button></div>${newRequestForm()}<section class="section">${rows.map(r=>{const target=state.data.doctors?.[r.targetDoctorId];return `<div class="request-card"><div><h3>${esc(TYPE[r.type])} · ${esc(r.protocol)}</h3><p>Data: ${fmtDate(r.eventDate)} · ${r.hours}h · <span class="status ${r.status}">${esc(r.status)}</span></p><p>Enviado: ${fmtTs(r.submittedAt)}${r.retroactive?' · RETROATIVO':''}</p>${target?`<p>Outro médico: ${esc(target.name)}</p>`:''}${r.decisionNote?`<p>Decisão: ${esc(r.decisionNote)}</p>`:''}</div><div class="actions">${r.type==='troca'&&r.targetDoctorId===state.session.id&&r.status==='pending_peer'?`<button class="btn good small" data-peer="${r.id}" data-accept="1">Aceitar troca</button><button class="btn danger small" data-peer="${r.id}" data-accept="0">Recusar</button>`:''}</div></div>`}).join('')||'<div class="card muted">Nenhuma solicitação.</div>'}</section>`;}
