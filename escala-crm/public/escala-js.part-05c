function auditView(){const rows=state.data.audit||[];return `<div class="hero"><div><div class="eyebrow">Rastreabilidade</div><h1>Auditoria</h1><p>Histórico administrativo das ações da escala.</p></div></div>${rows.map(a=>`<div class="card" style="margin:8px 0"><b>${fmtTs(a.occurredAt)} · ${esc(a.actorRole)} · ${esc(a.action)}</b><div>${esc(a.entityType)} ${esc(a.entityId||'')}</div></div>`).join('')||'<div class="card muted">Sem eventos.</div>'}`;}
