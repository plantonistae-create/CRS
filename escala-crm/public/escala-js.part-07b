async function setUnitAccess(e){e.preventDefault();const f=new FormData(e.currentTarget);try{await post('/api/admin/unit-access',{accessCode:f.get('accessCode')});toast('Código compartilhado atualizado.');}catch(err){toast(err.message,true)}}
async function submitDoctor(e){e.preventDefault();const f=Object.fromEntries(new FormData(e.currentTarget));try{await post('/api/admin/doctors',f);toast('Médico cadastrado.');await load();}catch(err){toast(err.message,true)}}
async function resetCrm(id){const crm=prompt('Novo CRM com 5 dígitos:');if(!crm)return;try{await post(`/api/admin/doctors/${id}/crm`,{crm});toast('CRM atualizado.');await load();}catch(e){toast(e.message,true)}}
async function submitTemplate(e){e.preventDefault();const f=Object.fromEntries(new FormData(e.currentTarget));f.weekday=Number(f.weekday);f.hours=Number(f.hours);try{await post('/api/admin/templates',f);toast('Padrão adicionado.');await load();}catch(err){toast(err.message,true)}}
async function delTemplate(id){if(!confirm('Remover este item do padrão semanal?'))return;try{await api(`/api/admin/templates/${id}`,{method:'DELETE'});toast('Removido.');await load();}catch(e){toast(e.message,true)}}
async function generateMonth(){if(!confirm(`Gerar ${monthLabel(state.month)} pelo padrão semanal? Alterações pontuais já travadas serão preservadas.`))return;try{const d=await post('/api/admin/generate-month',{month:state.month});toast(`${d.created} plantões gerados.`);await load();}catch(e){toast(e.message,true)}}
async function submitShift(e){e.preventDefault();const f=Object.fromEntries(new FormData(e.currentTarget));f.hours=Number(f.hours);try{await post('/api/admin/shifts',f);toast('Plantão adicionado.');await load();}catch(err){toast(err.message,true)}}
async function removeShift(id){if(!confirm('Remover este plantonista deste dia?'))return;try{await post(`/api/admin/shifts/${id}/remove`,{});toast('Plantão removido.');await load();}catch(e){toast(e.message,true)}}
