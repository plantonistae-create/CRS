async function replaceShift(id){const active=(state.data.doctorsList||[]).filter(d=>d.active),names=active.map((d,i)=>`${i+1}. ${d.name}`).join('\n'),n=Number(prompt(`Escolha o substituto:\n${names}`));if(!n||!active[n-1])return;const cat=prompt('Tipo do substituto: eventual, pagamento ou fixo','eventual');if(!cat)return;const fn=prompt('Função: emergencia_enfermaria, fichas, enfermaria ou cinderela','fichas');if(!fn)return;try{await post(`/api/admin/shifts/${id}/replace`,{doctorId:active[n-1].id,category:cat,function:fn});toast('Substituição registrada.');await load();}catch(e){toast(e.message,true)}}
async function submitRecord(e){e.preventDefault();const f=Object.fromEntries(new FormData(e.currentTarget));f.hours=Number(f.hours);try{await post('/api/admin/records',f);toast('Lançamento registrado.');await load();}catch(err){toast(err.message,true)}}
async function submitRequest(e){e.preventDefault();const fd=new FormData(e.currentTarget),file=fd.get('file'),body=Object.fromEntries(fd);delete body.file;body.hours=Number(body.hours);if(!body.shiftId)delete body.shiftId;if(!body.targetDoctorId)delete body.targetDoctorId;try{const d=await post('/api/requests',body);if(file&&file.size){const up=new FormData();up.append('file',file);await api(`/api/requests/${d.request.id}/attachment`,{method:'POST',body:up});}toast(`Solicitação enviada: ${d.request.protocol}`);await load();}catch(err){toast(err.message,true)}}
async function decide(btn){const id=btn.dataset.decide;let approve=btn.dataset.approve!=='0';const body={approve,note:prompt('Observação da decisão (opcional):','')||''};if(btn.dataset.debt!==undefined){approve=true;body.generatesDebt=btn.dataset.debt==='1';if(body.generatesDebt){const r=(state.data.requests||[]).find(x=>x.id===id);body.debtHours=Number(prompt('Quantas horas devem entrar no saldo a compensar?',String(r?.hours||12))||r?.hours||12);}}try{await post(`/api/admin/requests/${id}/decide`,body);toast('Decisão registrada.');await load();}catch(e){toast(e.message,true)}}
async function peer(btn){try{await post(`/api/requests/${btn.dataset.peer}/peer`,{accept:btn.dataset.accept==='1',note:''});toast('Resposta registrada.');await load();}catch(e){toast(e.message,true)}}
async function markNotif(id){try{await post(`/api/notifications/${id}/read`,{});await load();}catch(e){toast(e.message,true)}}
async function boot(){if('serviceWorker'in navigator)navigator.serviceWorker.register('/escala-sw.js').catch(()=>{});try{const st=await api('/api/auth/admin/status');state.adminConfigured=st.configured;state.unitAccessConfigured=st.unitAccessConfigured}catch{}await detectSession();await load();connectWs();}
boot();
