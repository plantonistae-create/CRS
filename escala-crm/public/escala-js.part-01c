function topbar(){if(!state.session)return `<header class="topbar"><div class="brand"><span class="brand-dot"></span><div><strong>CS Coophavila</strong><small>Escala médica online</small></div></div></header>`;let nav=[];if(state.session.role==='admin')nav=[['dashboard','Painel'],['schedule','Escala'],['templates','Padrão'],['doctors','Médicos'],['requests','Solicitações'],['audit','Auditoria']];else if(state.session.role==='doctor')nav=[['mine','Meus plantões'],['public','Escala completa'],['requests','Solicitações']];else nav=[['public','Escala pública']];const action=state.session.role==='doctor'?`<button class="btn small ghost" data-action="unidentify">Trocar CRM</button><button class="btn small ghost" data-action="logout">Sair</button>`:`<button class="btn small ghost" data-action="logout">Sair</button>`;return `<header class="topbar"><div class="brand"><span class="brand-dot"></span><div><strong>CS Coophavila</strong><small>Escala médica online</small></div></div><nav class="nav">${nav.map(([r,l])=>`<button class="${state.route===r?'active':''}" data-route="${r}">${l}</button>`).join('')}</nav><div class="top-actions"><span class="badge">${esc(state.session.role==='viewer'?'Acesso da unidade':state.session.name||state.session.role)}</span>${action}</div></header><div class="mobile-tabs">${nav.map(([r,l])=>`<button class="${state.route===r?'active':''}" data-route="${r}">${l}</button>`).join('')}</div>`;}
