      if(row.request_type==="atestado"){
        this.sql.exec("INSERT INTO certificates(id,doctor_id,event_date,hours,request_id,created_at) VALUES(?,?,?,?,?,?)",crypto.randomUUID(),row.doctor_id,row.event_date,row.hours,row.id,now);
        if(row.shift_id){const replacementId=b.targetDoctorId||row.target_doctor_id;if(replacementId){this.ensureDoctor(replacementId);const category=normalizeCategory(b.category||row.category||"eventual");if(category!=="fixo")this.assertExtraCapacity(row.event_date,row.hours,row.shift_id);this.sql.exec("UPDATE shifts SET doctor_id=?,category=?,active=1,locked=1,updated_at=? WHERE id=?",replacementId,category,now,row.shift_id);}else this.sql.exec("UPDATE shifts SET active=0,locked=1,updated_at=? WHERE id=?",now,row.shift_id);}
      }
      else if(row.request_type==="ausencia"){
        if(b.generatesDebt){const debtHours=hoursValue(b.debtHours||row.hours);this.sql.exec("INSERT INTO compensation(id,doctor_id,event_date,hours,kind,source,request_id,created_at) VALUES(?,?,?,?, 'debt','absence',?,?)",crypto.randomUUID(),row.doctor_id,row.event_date,debtHours,row.id,now);}
        if(row.shift_id){const replacementId=b.targetDoctorId||row.target_doctor_id;if(replacementId){this.ensureDoctor(replacementId);const category=normalizeCategory(b.category||row.category||"eventual");if(category!=="fixo")this.assertExtraCapacity(row.event_date,row.hours,row.shift_id);this.sql.exec("UPDATE shifts SET doctor_id=?,category=?,active=1,locked=1,updated_at=? WHERE id=?",replacementId,category,now,row.shift_id);}else this.sql.exec("UPDATE shifts SET active=0,locked=1,updated_at=? WHERE id=?",now,row.shift_id);}
      }
      else if(row.request_type==="troca"){
        const shift=this.ensureShift(row.shift_id),replacementId=b.targetDoctorId||row.target_doctor_id;if(!replacementId)throw new ScaleError("Selecione o médico substituto.");this.ensureDoctor(replacementId);const category=normalizeCategory(b.category||row.category||"eventual");if(category!=="fixo")this.assertExtraCapacity(shift.shift_date,shift.hours,shift.id);this.sql.exec("UPDATE shifts SET doctor_id=?,category=?,active=1,locked=1,updated_at=? WHERE id=?",replacementId,category,now,shift.id);
      }
      else if(row.request_type==="pagamento"){if(row.shift_id){const shift=this.ensureShift(row.shift_id);if(shift.doctor_id!==row.doctor_id)throw new ScaleError("O plantão vinculado não pertence mais ao médico solicitante.",409);this.sql.exec("INSERT INTO compensation(id,doctor_id,event_date,hours,kind,source,request_id,created_at) VALUES(?,?,?,?, 'paid','request',?,?)",crypto.randomUUID(),row.doctor_id,row.event_date,row.hours,row.id,now);}else{this.assertExtraCapacity(row.event_date,row.hours);const sid=crypto.randomUUID();this.sql.exec(`INSERT INTO shifts(id,shift_date,start_time,end_time,hours,doctor_id,planned_doctor_id,function_code,category,source,source_template_id,active,locked,created_at,updated_at) VALUES(?,?,?,?,?,?,NULL,?,?,?,NULL,1,1,?,?)`,sid,row.event_date,row.start_time,row.end_time,row.hours,row.doctor_id,row.function_code,"pagamento",`request:${row.id}`,now,now);this.sql.exec("INSERT INTO compensation(id,doctor_id,event_date,hours,kind,source,request_id,created_at) VALUES(?,?,?,?, 'paid','request',?,?)",crypto.randomUUID(),row.doctor_id,row.event_date,row.hours,row.id,now);}}
      else if(row.request_type==="extra"){this.assertExtraCapacity(row.event_date,row.hours);const sid=crypto.randomUUID();this.sql.exec(`INSERT INTO shifts(id,shift_date,start_time,end_time,hours,doctor_id,planned_doctor_id,function_code,category,source,source_template_id,active,locked,created_at,updated_at) VALUES(?,?,?,?,?,?,NULL,?,?,?,NULL,1,1,?,?)`,sid,row.event_date,row.start_time,row.end_time,row.hours,row.doctor_id,row.function_code,"eventual",`request:${row.id}`,now,now);}
    }
