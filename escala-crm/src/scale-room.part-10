      if(row.request_type==="atestado"){ this.sql.exec("INSERT INTO certificates(id,doctor_id,event_date,hours,request_id,created_at) VALUES(?,?,?,?,?,?)",crypto.randomUUID(),row.doctor_id,row.event_date,row.hours,row.id,now); if(row.shift_id) this.sql.exec("UPDATE shifts SET active=0,locked=1,updated_at=? WHERE id=?",now,row.shift_id); }
      else if(row.request_type==="ausencia"){ if(b.generatesDebt){ const debtHours=hoursValue(b.debtHours||row.hours); this.sql.exec("INSERT INTO compensation(id,doctor_id,event_date,hours,kind,source,request_id,created_at) VALUES(?,?,?,?, 'debt','absence',?,?)",crypto.randomUUID(),row.doctor_id,row.event_date,debtHours,row.id,now); } if(row.shift_id) this.sql.exec("UPDATE shifts SET active=0,locked=1,updated_at=? WHERE id=?",now,row.shift_id); }
      else if(row.request_type==="troca"){ const shift=this.ensureShift(row.shift_id); const category=normalizeCategory(row.category||"eventual"); if(category!=="fixo") this.assertExtraCapacity(shift.shift_date,shift.hours,shift.id); this.sql.exec("UPDATE shifts SET doctor_id=?,category=?,active=1,locked=1,updated_at=? WHERE id=?",row.target_doctor_id,category,now,shift.id); }
      else if(row.request_type==="pagamento"||row.request_type==="extra"){ const category=row.request_type==="pagamento"?"pagamento":"eventual"; this.assertExtraCapacity(row.event_date,row.hours); const sid=crypto.randomUUID(); this.sql.exec(`INSERT INTO shifts(id,shift_date,start_time,end_time,hours,doctor_id,planned_doctor_id,function_code,category,source,source_template_id,active,locked,created_at,updated_at) VALUES(?,?,?,?,?,?,NULL,?,?,?,NULL,1,1,?,?)`,sid,row.event_date,row.start_time,row.end_time,row.hours,row.doctor_id,row.function_code,category,`request:${row.id}`,now,now); if(row.request_type==="pagamento") this.sql.exec("INSERT INTO compensation(id,doctor_id,event_date,hours,kind,source,request_id,created_at) VALUES(?,?,?,?, 'paid','request',?,?)",crypto.randomUUID(),row.doctor_id,row.event_date,row.hours,row.id,now); }
    }
    const status=approve?"approved":"rejected"; this.sql.exec("UPDATE requests SET status=?,decided_at=?,decided_by='admin',decision_note=? WHERE id=?",status,now,decisionNote,id); const doctor=this.ensureDoctor(row.doctor_id); this.notify("doctor",doctor.id,approve?"Solicitação aprovada":"Solicitação recusada",`${row.protocol} · ${this.typeLabel(row.request_type)}`,"decision"); this.audit(actor.role,actor.id,approve?"approve":"reject","request",id,row,{...row,status,decisionNote}); await this.commitAndBroadcast(); return json({ok:true,status});
  }
  async readNotification(request,id){ const actor=await this.actor(request); const now=Date.now(); if(actor.role==="admin") this.sql.exec("UPDATE notifications SET read_at=? WHERE id=? AND target_role='admin'",now,id); else this.sql.exec("UPDATE notifications SET read_at=? WHERE id=? AND target_doctor_id=?",now,id,actor.id); await this.ctx.storage.sync(); return json({ok:true}); }

  async attachmentAccess(request,id){ const actor=await this.actor(request); const row=this.ensureRequest(id); if(actor.role!=="admin" && row.doctor_id!==actor.id) throw new ScaleError("Você não pode acessar este documento.",403); return { requestId:id, attachment: row.attachment_key?{key:row.attachment_key,name:row.attachment_name,mime:row.attachment_mime,size:Number(row.attachment_size||0)}:null }; }
  async attachmentRecord(request,id){ const actor=await this.actor(request); const row=this.ensureRequest(id); if(actor.role!=="admin" && row.doctor_id!==actor.id) throw new ScaleError("Você não pode anexar a esta solicitação.",403); const b=await this.readJson(request); const key=text(b.key,160,"chave"), name=text(b.name,240,"nome do arquivo"), mime=text(b.mime,100,"tipo"), size=Number(b.size||0); if(!key||!name||!mime||!Number.isFinite(size)||size<=0) throw new ScaleError("Metadados do anexo inválidos."); this.sql.exec("UPDATE requests SET attachment_key=?,attachment_name=?,attachment_mime=?,attachment_size=? WHERE id=?",key,name,mime,size,id); this.audit(actor.role,actor.id,"attach","request",id,null,{name,mime,size}); await this.commitAndBroadcast(); return json({ok:true}); }

  ensureDoctor(id){ const r=this.sql.exec("SELECT * FROM doctors WHERE id=? AND active=1",id).toArray()[0]; if(!r) throw new ScaleError("Médico não encontrado.",404); return r; }
