      hours REAL NOT NULL DEFAULT 0, shift_id TEXT, target_doctor_id TEXT, start_time TEXT, end_time TEXT, function_code TEXT, category TEXT,
      notes TEXT NOT NULL DEFAULT '', status TEXT NOT NULL, retroactive INTEGER NOT NULL DEFAULT 0, retro_reason TEXT NOT NULL DEFAULT '',
      submitted_at INTEGER NOT NULL, decided_at INTEGER, decided_by TEXT, decision_note TEXT NOT NULL DEFAULT '',
      attachment_key TEXT, attachment_name TEXT, attachment_mime TEXT, attachment_size INTEGER NOT NULL DEFAULT 0,
      FOREIGN KEY(doctor_id) REFERENCES doctors(id), FOREIGN KEY(target_doctor_id) REFERENCES doctors(id))`);
    this.sql.exec(`CREATE TABLE IF NOT EXISTS certificates (
      id TEXT PRIMARY KEY, doctor_id TEXT NOT NULL, event_date TEXT NOT NULL, hours REAL NOT NULL, request_id TEXT, created_at INTEGER NOT NULL,
      FOREIGN KEY(doctor_id) REFERENCES doctors(id))`);
    this.sql.exec(`CREATE TABLE IF NOT EXISTS compensation (
      id TEXT PRIMARY KEY, doctor_id TEXT NOT NULL, event_date TEXT NOT NULL, hours REAL NOT NULL, kind TEXT NOT NULL CHECK(kind IN ('debt','paid')),
      source TEXT NOT NULL, request_id TEXT, created_at INTEGER NOT NULL, FOREIGN KEY(doctor_id) REFERENCES doctors(id))`);
    this.sql.exec(`CREATE TABLE IF NOT EXISTS notifications (
      id INTEGER PRIMARY KEY AUTOINCREMENT, target_role TEXT NOT NULL, target_doctor_id TEXT, title TEXT NOT NULL, body TEXT NOT NULL,
      kind TEXT NOT NULL, created_at INTEGER NOT NULL, read_at INTEGER)`);
    this.sql.exec(`CREATE TABLE IF NOT EXISTS audit_log (
      id INTEGER PRIMARY KEY AUTOINCREMENT, actor_role TEXT NOT NULL, actor_id TEXT, action TEXT NOT NULL, entity_type TEXT NOT NULL,
      entity_id TEXT, old_json TEXT, new_json TEXT, occurred_at INTEGER NOT NULL)`);
    this.sql.exec("CREATE INDEX IF NOT EXISTS idx_shifts_date ON shifts(shift_date,active)");
    this.sql.exec("CREATE INDEX IF NOT EXISTS idx_shifts_planned ON shifts(planned_doctor_id,shift_date)");
    this.sql.exec("CREATE INDEX IF NOT EXISTS idx_requests_doctor ON requests(doctor_id,submitted_at DESC)");
    this.sql.exec("CREATE INDEX IF NOT EXISTS idx_notifications_target ON notifications(target_role,target_doctor_id,created_at DESC)");
    this.sql.exec("PRAGMA optimize");
  }

  async fetch(request) {
    try {
      const url = new URL(request.url);
      const p = url.pathname;
      if (p === "/realtime") return await this.connectWs(request, url);
      if (request.method === "GET" && p === "/auth/admin/status") return this.adminStatus();
      if (request.method === "POST" && p === "/auth/unit/login") return await this.unitLogin(request);
      if (request.method === "POST" && p === "/auth/unit/logout") return await this.unitLogout(request);
      if (request.method === "POST" && p === "/auth/admin/bootstrap") return await this.adminBootstrap(request);
      if (request.method === "POST" && p === "/auth/admin/login") return await this.adminLogin(request);
      if (request.method === "POST" && p === "/auth/admin/logout") return await this.adminLogout(request);
      if (request.method === "POST" && p === "/admin/password") return await this.adminChangePassword(request);
      if (request.method === "POST" && p === "/auth/identify") return await this.doctorLogin(request);
      if (request.method === "POST" && p === "/auth/unidentify") return await this.doctorLogout(request);
      if (request.method === "GET" && p === "/session") return this.sessionResponse(request);
      if (request.method === "GET" && p === "/public") { await this.actor(request); return json(this.publicState(monthOnly(url.searchParams.get("month") || new Date().toISOString().slice(0,7)))); }
      if (request.method === "GET" && p === "/state") return json(await this.privateState(request, monthOnly(url.searchParams.get("month") || new Date().toISOString().slice(0,7))));

      if (request.method === "POST" && p === "/admin/doctors") return await this.adminCreateDoctor(request);
      const doctorCrm = p.match(/^\/admin\/doctors\/([^/]+)\/crm$/);
      if (request.method === "POST" && doctorCrm) return await this.adminResetPassword(request, doctorCrm[1]);
      if (request.method === "POST" && p === "/admin/unit-access") return await this.adminSetUnitAccess(request);
      if (request.method === "POST" && p === "/admin/templates") return await this.adminCreateTemplate(request);
      const templateDelete = p.match(/^\/admin\/templates\/([^/]+)$/);
      if (request.method === "DELETE" && templateDelete) return await this.adminDeleteTemplate(request, templateDelete[1]);
