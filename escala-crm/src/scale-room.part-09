    else throw new ScaleError("Tipo de lançamento inválido.");
    this.audit(actor.role,actor.id,"retroactive_record",kind,id,null,{...b,reason}); await this.commitAndBroadcast(); return json({ok:true,id},201);
  }

  async createRequest(request){
    const actor=await this.actor(request,{doctorOnly:true}); const b=await this.readJson(request); const type=String(b.type||""); if(!REQUEST_TYPES.has(type)) throw new ScaleError("Tipo de solicitação inválido."); const eventDate=dateOnly(b.eventDate); const hours=hoursValue(b.hours||1); const now=Date.now(); const isRetro=eventDate < new Date(now).toISOString().slice(0,10); const retroReason=isRetro?text(b.retroReason,500,"motivo retroativo"):""; if(isRetro&&!retroReason) throw new ScaleError("Informe o motivo do lançamento retroativo.");
    let shift=null; if(b.shiftId){ shift=this.ensureShift(b.shiftId); if(shift.doctor_id!==actor.id && type!=="extra"&&type!=="pagamento") throw new ScaleError("Este plantão não pertence ao seu usuário.",403); }
    let target=null; if(type==="troca"){ if(!b.targetDoctorId) throw new ScaleError("Escolha o médico substituto."); target=this.ensureDoctor(b.targetDoctorId); if(target.id===actor.id) throw new ScaleError("Escolha outro médico para a troca."); }
    const start=b.start?timeOnly(b.start,"início"):(shift?.start_time||null), end=b.end?timeOnly(b.end,"fim"):(shift?.end_time||null), fn=b.function?normalizeFunction(b.function):(shift?.function_code||null), category=(type==="troca"||type==="extra"||type==="pagamento")?normalizeCategory(b.category||(type==="pagamento"?"pagamento":"eventual")):(shift?.category||null);
    if((type==="extra"||type==="pagamento")&&(!start||!end||!fn)) throw new ScaleError("Informe horário e função do plantão solicitado."); if((type==="extra"||type==="pagamento")&&fn) validateFunctionSchedule(fn,start,end,hours);
    const id=crypto.randomUUID(), protocol=`ESC-${new Date(now).getUTCFullYear()}-${String(now).slice(-6)}-${Math.floor(Math.random()*900+100)}`, status=type==="troca"?"pending_peer":"pending";
    this.sql.exec(`INSERT INTO requests(id,protocol,doctor_id,request_type,event_date,hours,shift_id,target_doctor_id,start_time,end_time,function_code,category,notes,status,retroactive,retro_reason,submitted_at,decided_at,decided_by,decision_note,attachment_key,attachment_name,attachment_mime,attachment_size)
      VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,NULL,NULL,'',NULL,NULL,NULL,0)`,id,protocol,actor.id,type,eventDate,hours,b.shiftId||null,b.targetDoctorId||null,start,end,fn,category,text(b.notes,2000,"observação"),status,isRetro?1:0,retroReason,now);
    this.notify("admin",null,`Nova solicitação: ${this.typeLabel(type)}`,`${actor.name} enviou ${protocol}.`,"request"); if(target) this.notify("doctor",target.id,"Solicitação de troca",`${actor.name} solicitou sua participação em uma troca de plantão.`,"swap");
    this.audit(actor.role,actor.id,"submit","request",id,null,{type,eventDate,hours,status}); await this.commitAndBroadcast(); return json({request:mapRequest(this.sql.exec("SELECT * FROM requests WHERE id=?",id).one())},201);
  }
  async peerDecision(request,id){ const actor=await this.actor(request,{doctorOnly:true}); const row=this.ensureRequest(id); if(row.request_type!=="troca"||row.target_doctor_id!==actor.id||row.status!=="pending_peer") throw new ScaleError("Esta troca não aguarda sua decisão.",409); const b=await this.readJson(request); const accept=!!b.accept; const status=accept?"pending_admin":"rejected"; const now=Date.now(); this.sql.exec("UPDATE requests SET status=?,decided_at=?,decision_note=? WHERE id=?",status,accept?null:now,text(b.note,500,"observação"),id); this.notify("admin",null,accept?"Troca aceita pelo substituto":"Troca recusada pelo substituto",`${row.protocol} · ${actor.name}`,"swap"); this.audit(actor.role,actor.id,accept?"peer_accept":"peer_reject","request",id,row,{...row,status}); await this.commitAndBroadcast(); return json({ok:true,status}); }
  async adminDecision(request,id){
    const actor=await this.actor(request,{adminOnly:true}); const row=this.ensureRequest(id); if(!["pending","pending_admin"].includes(row.status)) throw new ScaleError("Esta solicitação já foi decidida ou ainda aguarda o outro médico.",409); const b=await this.readJson(request); const approve=!!b.approve; const now=Date.now(); const decisionNote=text(b.note,1000,"observação");
    if(approve){
