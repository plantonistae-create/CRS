    else throw new ScaleError("Tipo de lançamento inválido.");
    this.audit(actor.role,actor.id,"retroactive_record",kind,id,null,{...b,reason}); await this.commitAndBroadcast(); return json({ok:true,id},201);
  }

  async createRequest(request){
    const actor=await this.actor(request,{doctorOnly:true}); const b=await this.readJson(request); const type=String(b.type||""); if(!REQUEST_TYPES.has(type)) throw new ScaleError("Tipo de solicitação inválido.");
    const needsShift=["atestado","ausencia","troca","pagamento"].includes(type); if(needsShift&&!b.shiftId) throw new ScaleError("Escolha um dos seus plantões futuros.");
    let shift=null; if(b.shiftId){shift=this.ensureShift(b.shiftId);if(shift.doctor_id!==actor.id)throw new ScaleError("Este plantão não pertence ao seu usuário.",403);}
    const eventDate=shift?shift.shift_date:dateOnly(b.eventDate), hours=shift?Number(shift.hours):hoursValue(b.hours||1), start=shift?.start_time||(b.start?timeOnly(b.start,"início"):null), end=shift?.end_time||(b.end?timeOnly(b.end,"fim"):null), fn=shift?.function_code||(b.function?normalizeFunction(b.function):null), category=type==="pagamento"?"pagamento":type==="extra"?normalizeCategory(b.category||"eventual"):type==="troca"?normalizeCategory(b.category||"eventual"):(shift?.category||null);
    if(type==="extra"&&(!start||!end||!fn))throw new ScaleError("Informe horário e função do plantão solicitado."); if(type==="extra"&&fn)validateFunctionSchedule(fn,start,end,hours);
    const now=Date.now(), parts=Object.fromEntries(new Intl.DateTimeFormat("en-CA",{timeZone:"America/Campo_Grande",year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit",hour12:false}).formatToParts(new Date(now)).filter(p=>p.type!=="literal").map(p=>[p.type,p.value])), localDate=`${parts.year}-${parts.month}-${parts.day}`, localTime=`${parts.hour}:${parts.minute}`;
    if(eventDate<localDate||(eventDate===localDate&&start&&start<=localTime))throw new ScaleError("Médicos só podem solicitar alterações em plantões futuros. Retroativos são exclusivos da administração.",409);
    let target=null;if(type==="troca"){if(!b.targetDoctorId)throw new ScaleError("Escolha o médico substituto.");target=this.ensureDoctor(b.targetDoctorId);if(target.id===actor.id)throw new ScaleError("Escolha outro médico para a troca.");}
    const id=crypto.randomUUID(),protocol=`ESC-${new Date(now).getUTCFullYear()}-${String(now).slice(-6)}-${Math.floor(Math.random()*900+100)}`,status=type==="troca"?"pending_peer":"pending";
    this.sql.exec(`INSERT INTO requests(id,protocol,doctor_id,request_type,event_date,hours,shift_id,target_doctor_id,start_time,end_time,function_code,category,notes,status,retroactive,retro_reason,submitted_at,decided_at,decided_by,decision_note,attachment_key,attachment_name,attachment_mime,attachment_size) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,0,'',?,NULL,NULL,'',NULL,NULL,NULL,0)`,id,protocol,actor.id,type,eventDate,hours,b.shiftId||null,b.targetDoctorId||null,start,end,fn,category,text(b.notes,2000,"observação"),status,now);
    this.notify("admin",null,`Nova solicitação: ${this.typeLabel(type)}`,`${actor.name} enviou ${protocol}.`,"request");if(target)this.notify("doctor",target.id,"Solicitação de troca",`${actor.name} solicitou sua participação em uma troca de plantão.`,"swap");this.audit(actor.role,actor.id,"submit","request",id,null,{type,eventDate,hours,status,shiftId:b.shiftId||null});await this.commitAndBroadcast();return json({request:mapRequest(this.sql.exec("SELECT * FROM requests WHERE id=?",id).one())},201);
  }
