        for (const t of templates.filter((x) => Number(x.weekday) === weekday)) {
          const locked = this.sql.exec("SELECT id FROM shifts WHERE shift_date=? AND source_template_id=? AND locked=1 LIMIT 1", date, t.id).toArray()[0]; if (locked) continue;
