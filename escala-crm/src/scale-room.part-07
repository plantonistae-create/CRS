    return { doctorId, name: doc?.name || "", plannedHours: planned, attestationHours: att, attestationPercent: pct, attestationLimitHours: Math.round(planned * 0.25 * 100) / 100, debtHours: debt, paidHours: paid, balanceHours: Math.max(0, Math.round((debt - paid) * 100) / 100), extraHours: extra };
  }

  async adminCreateDoctor(request) {
    const actor = await this.actor(request, { adminOnly: true }); const b = await this.readJson(request);
    const name = text(b.name, 120, "nome"); if (name.length < 2) throw new ScaleError("Informe o nome do médico.");
    const crm = text(b.crm, 5, "CRM"); if (!/^\d{5}$/.test(crm)) throw new ScaleError("O CRM deve conter exatamente 5 dígitos.");
    const salt = hex(crypto.getRandomValues(new Uint8Array(16))); const hash = await passwordHash(randomToken().slice(0,16), salt); const id = crypto.randomUUID(); const now = Date.now();
    try { this.sql.exec("INSERT INTO doctors(id,name,login,password_salt,password_hash,active,created_at,updated_at,crm) VALUES(?,?,?,?,?,1,?,?,?)", id, name, crm, salt, hash, now, now, crm); }
    catch { throw new ScaleError("Este CRM já está cadastrado.", 409); }
    this.audit(actor.role, actor.id, "create", "doctor", id, null, { name, crm }); await this.commitAndBroadcast();
    return json({ doctor: mapDoctor(this.sql.exec("SELECT * FROM doctors WHERE id=?", id).one()) }, 201);
  }
  async adminResetPassword(request, id) {
    const actor = await this.actor(request, { adminOnly: true }); const b = await this.readJson(request); this.ensureDoctor(id);
    const crm = text(b.crm, 5, "CRM"); if (!/^\d{5}$/.test(crm)) throw new ScaleError("O CRM deve conter exatamente 5 dígitos.");
    try { this.sql.exec("UPDATE doctors SET crm=?,login=?,updated_at=? WHERE id=?", crm, crm, Date.now(), id); }
    catch { throw new ScaleError("Este CRM já está cadastrado para outro médico.", 409); }
    this.sql.exec("DELETE FROM sessions WHERE doctor_id=?", id);
    this.audit(actor.role, actor.id, "crm_update", "doctor", id, null, { crm }); await this.commitAndBroadcast(); return json({ ok: true });
  }
  async adminCreateTemplate(request) {
    const actor = await this.actor(request, { adminOnly: true }); const b = await this.readJson(request); this.ensureDoctor(b.doctorId);
    const weekday = Number(b.weekday); if (!Number.isInteger(weekday) || weekday < 0 || weekday > 6) throw new ScaleError("Dia da semana inválido.");
    const start = timeOnly(b.start, "início"), end = timeOnly(b.end, "fim"), hours = hoursValue(b.hours), fn = normalizeFunction(b.function), category = normalizeCategory(b.category || "fixo"); validateFunctionSchedule(fn, start, end, hours);
    const id = crypto.randomUUID(), now = Date.now();
    this.sql.exec("INSERT INTO weekly_template(id,weekday,start_time,end_time,hours,doctor_id,function_code,category,created_at) VALUES(?,?,?,?,?,?,?,?,?)", id, weekday, start, end, hours, b.doctorId, fn, category, now);
    this.audit(actor.role, actor.id, "create", "weekly_template", id, null, b); await this.commitAndBroadcast(); return json({ ok: true, id }, 201);
  }
  async adminDeleteTemplate(request, id) {
    const actor = await this.actor(request, { adminOnly: true }); const old = this.sql.exec("SELECT * FROM weekly_template WHERE id=?", id).toArray()[0]; if (!old) throw new ScaleError("Padrão não encontrado.", 404);
    this.sql.exec("DELETE FROM weekly_template WHERE id=?", id); this.audit(actor.role, actor.id, "delete", "weekly_template", id, old, null); await this.commitAndBroadcast(); return json({ ok: true });
  }
  async adminGenerateMonth(request) {
    const actor = await this.actor(request, { adminOnly: true }); const b = await this.readJson(request); const month = monthOnly(b.month); const [y,m] = month.split("-").map(Number); const templates = this.templateRows(); const now = Date.now(); let created = 0;
    this.ctx.storage.transactionSync(() => {
