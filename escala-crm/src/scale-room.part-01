function mapDoctor(row) { return { id: row.id, name: row.name, crm: row.crm || row.login || "", doctorType: row.doctor_type || "folha", active: !!row.active, createdAt: new Date(row.created_at).toISOString() }; }
function mapShift(row) {
  return { id: row.id, date: row.shift_date, start: row.start_time, end: row.end_time, hours: Number(row.hours), doctorId: row.doctor_id,
    plannedDoctorId: row.planned_doctor_id || null, function: row.function_code, category: row.category, source: row.source,
    active: !!row.active, locked: !!row.locked, createdAt: new Date(row.created_at).toISOString(), updatedAt: new Date(row.updated_at).toISOString() };
}
function mapRequest(row) {
  return { id: row.id, protocol: row.protocol, doctorId: row.doctor_id, type: row.request_type, eventDate: row.event_date, hours: Number(row.hours || 0),
    shiftId: row.shift_id || null, targetDoctorId: row.target_doctor_id || null, start: row.start_time || "", end: row.end_time || "",
    function: row.function_code || "", category: row.category || "", notes: row.notes || "", status: row.status,
    retroactive: !!row.retroactive, retroReason: row.retro_reason || "", submittedAt: new Date(row.submitted_at).toISOString(),
    decidedAt: row.decided_at ? new Date(row.decided_at).toISOString() : null, decisionNote: row.decision_note || "",
    attachment: row.attachment_key ? { key: row.attachment_key, name: row.attachment_name, mime: row.attachment_mime, size: Number(row.attachment_size || 0) } : null };
}

export class ScaleRoom extends DurableObject {
  constructor(ctx, env) {
    super(ctx, env);
    this.sql = this.ctx.storage.sql;
    this.sql.exec("PRAGMA foreign_keys = ON");
    this.sql.exec(`CREATE TABLE IF NOT EXISTS doctors (
      id TEXT PRIMARY KEY, name TEXT NOT NULL, login TEXT NOT NULL UNIQUE, password_salt TEXT NOT NULL, password_hash TEXT NOT NULL,
      active INTEGER NOT NULL DEFAULT 1, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL)`);
    const doctorCols = this.sql.exec("PRAGMA table_info(doctors)").toArray();
    if (!doctorCols.some((c) => c.name === "crm")) {
      this.sql.exec("ALTER TABLE doctors ADD COLUMN crm TEXT");
      this.sql.exec("UPDATE doctors SET crm=login WHERE login GLOB '[0-9][0-9][0-9][0-9]*'");
      this.sql.exec("CREATE UNIQUE INDEX IF NOT EXISTS idx_doctors_crm ON doctors(crm)");
    }
    if (!doctorCols.some((c) => c.name === "doctor_type")) {
      this.sql.exec("ALTER TABLE doctors ADD COLUMN doctor_type TEXT NOT NULL DEFAULT 'folha'");
    }
    this.sql.exec(`CREATE TABLE IF NOT EXISTS sessions (
      token_hash TEXT PRIMARY KEY, doctor_id TEXT NOT NULL, created_at INTEGER NOT NULL, expires_at INTEGER NOT NULL,
      FOREIGN KEY(doctor_id) REFERENCES doctors(id))`);
    this.sql.exec(`CREATE TABLE IF NOT EXISTS unit_access (
      id TEXT PRIMARY KEY, password_salt TEXT NOT NULL, password_hash TEXT NOT NULL, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL)`);
    this.sql.exec(`CREATE TABLE IF NOT EXISTS viewer_sessions (
      token_hash TEXT PRIMARY KEY, created_at INTEGER NOT NULL, expires_at INTEGER NOT NULL)`);
    this.sql.exec(`CREATE TABLE IF NOT EXISTS admin_config (
      id TEXT PRIMARY KEY, name TEXT NOT NULL, password_salt TEXT NOT NULL, password_hash TEXT NOT NULL, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL)`);
    this.sql.exec(`CREATE TABLE IF NOT EXISTS admin_sessions (
      token_hash TEXT PRIMARY KEY, created_at INTEGER NOT NULL, expires_at INTEGER NOT NULL)`);
    this.sql.exec(`CREATE TABLE IF NOT EXISTS weekly_template (
      id TEXT PRIMARY KEY, weekday INTEGER NOT NULL CHECK(weekday BETWEEN 0 AND 6), start_time TEXT NOT NULL, end_time TEXT NOT NULL,
      hours REAL NOT NULL, doctor_id TEXT NOT NULL, function_code TEXT NOT NULL, category TEXT NOT NULL DEFAULT 'fixo', created_at INTEGER NOT NULL,
      FOREIGN KEY(doctor_id) REFERENCES doctors(id))`);
    this.sql.exec(`CREATE TABLE IF NOT EXISTS shifts (
      id TEXT PRIMARY KEY, shift_date TEXT NOT NULL, start_time TEXT NOT NULL, end_time TEXT NOT NULL, hours REAL NOT NULL,
      doctor_id TEXT NOT NULL, planned_doctor_id TEXT, function_code TEXT NOT NULL, category TEXT NOT NULL,
      source TEXT NOT NULL, source_template_id TEXT, active INTEGER NOT NULL DEFAULT 1, locked INTEGER NOT NULL DEFAULT 0,
      created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL,
      FOREIGN KEY(doctor_id) REFERENCES doctors(id), FOREIGN KEY(planned_doctor_id) REFERENCES doctors(id))`);
    this.sql.exec(`CREATE TABLE IF NOT EXISTS requests (
      id TEXT PRIMARY KEY, protocol TEXT NOT NULL UNIQUE, doctor_id TEXT NOT NULL, request_type TEXT NOT NULL, event_date TEXT NOT NULL,
