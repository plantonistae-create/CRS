  async attachmentAccess(request,id){const actor=await this.actor(request);const row=this.ensureRequest(id);if(actor.role!=="admin"&&row.doctor_id!==actor.id)throw new ScaleError("Você não pode acessar este documento.",403);return{requestId:id,attachment:row.attachment_key?{key:row.attachment_key,name:row.attachment_name,mime:row.attachment_mime,size:Number(row.attachment_size||0)}:null};}
  async attachmentRecord(request,id){const actor=await this.actor(request);const row=this.ensureRequest(id);if(actor.role!=="admin"&&row.doctor_id!==actor.id)throw new ScaleError("Você não pode anexar a esta solicitação.",403);const b=await this.readJson(request),key=text(b.key,160,"chave"),name=text(b.name,240,"nome do arquivo"),mime=text(b.mime,100,"tipo"),size=Number(b.size||0);if(!key||!name||!mime||!Number.isFinite(size)||size<=0)throw new ScaleError("Metadados do anexo inválidos.");this.sql.exec("UPDATE requests SET attachment_key=?,attachment_name=?,attachment_mime=?,attachment_size=? WHERE id=?",key,name,mime,size,id);this.audit(actor.role,actor.id,"attach","request",id,null,{name,mime,size});await this.commitAndBroadcast();return json({ok:true});}
  ensureDoctor(id){const r=this.sql.exec("SELECT * FROM doctors WHERE id=? AND active=1",id).toArray()[0];if(!r)throw new ScaleError("Médico não encontrado.",404);return r;}
