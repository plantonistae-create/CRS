    const status=approve?"approved":"rejected";this.sql.exec("UPDATE requests SET status=?,decided_at=?,decided_by='admin',decision_note=? WHERE id=?",status,now,decisionNote,id);const doctor=this.ensureDoctor(row.doctor_id);this.notify("doctor",doctor.id,approve?"Solicitação aprovada":"Solicitação recusada",`${row.protocol} · ${this.typeLabel(row.request_type)}`,"decision");this.audit(actor.role,actor.id,approve?"approve":"reject","request",id,row,{...row,status,decisionNote});await this.commitAndBroadcast();return json({ok:true,status});
  }
  async readNotification(request,id){const actor=await this.actor(request);const now=Date.now();if(actor.role==="admin")this.sql.exec("UPDATE notifications SET read_at=? WHERE id=? AND target_role='admin'",now,id);else this.sql.exec("UPDATE notifications SET read_at=? WHERE id=? AND target_doctor_id=?",now,id,actor.id);await this.ctx.storage.sync();return json({ok:true});}
