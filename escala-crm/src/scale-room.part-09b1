  async peerDecision(request,id){const actor=await this.actor(request,{doctorOnly:true});const row=this.ensureRequest(id);if(row.request_type!=="troca"||row.target_doctor_id!==actor.id||row.status!=="pending_peer")throw new ScaleError("Esta troca não aguarda sua decisão.",409);const b=await this.readJson(request);const accept=!!b.accept,status=accept?"pending_admin":"rejected",now=Date.now();this.sql.exec("UPDATE requests SET status=?,decided_at=?,decision_note=? WHERE id=?",status,accept?null:now,text(b.note,500,"observação"),id);this.notify("admin",null,accept?"Troca aceita pelo substituto":"Troca recusada pelo substituto",`${row.protocol} · ${actor.name}`,"swap");this.audit(actor.role,actor.id,accept?"peer_accept":"peer_reject","request",id,row,{...row,status});await this.commitAndBroadcast();return json({ok:true,status});}
