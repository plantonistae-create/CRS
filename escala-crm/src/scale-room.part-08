          const id = crypto.randomUUID();
          this.sql.exec(`INSERT INTO shifts(id,shift_date,start_time,end_time,hours,doctor_id,planned_doctor_id,function_code,category,source,source_template_id,active,locked,created_at,updated_at)
            VALUES(?,?,?,?,?,?,?,?,?,'template',?,1,0,?,?)`, id, date, t.start_time, t.end_time, t.hours, t.doctor_id, t.doctor_id, t.function_code, t.category, t.id, now, now); created++;
        }
      }
    });
    this.audit(actor.role, actor.id, "generate_month", "schedule", month, null, { created }); await this.commitAndBroadcast(); return json({ ok: true, created });
  }
  async adminAddShift(request) {
    const actor = await this.actor(request, { adminOnly: true }); const b = await this.readJson(request); const date = dateOnly(b.date), start = timeOnly(b.start,"início"), end = timeOnly(b.end,"fim"), hours = hoursValue(b.hours), fn = normalizeFunction(b.function), category = normalizeCategory(b.category); validateFunctionSchedule(fn, start, end, hours); this.ensureDoctor(b.doctorId);
    if (category !== "fixo") this.assertExtraCapacity(date, hours);
    const id = crypto.randomUUID(), now = Date.now(), planned = category === "fixo" ? b.doctorId : null;
    this.sql.exec(`INSERT INTO shifts(id,shift_date,start_time,end_time,hours,doctor_id,planned_doctor_id,function_code,category,source,source_template_id,active,locked,created_at,updated_at)
      VALUES(?,?,?,?,?,?,?,?,?,'manual',NULL,1,1,?,?)`, id,date,start,end,hours,b.doctorId,planned,fn,category,now,now);
    this.audit(actor.role,actor.id,"create","shift",id,null,b); await this.commitAndBroadcast(); return json({ shift: mapShift(this.sql.exec("SELECT * FROM shifts WHERE id=?",id).one()) },201);
  }
  async adminReplaceShift(request, id) {
    const actor = await this.actor(request,{adminOnly:true}); const old=this.ensureShift(id); const b=await this.readJson(request); this.ensureDoctor(b.doctorId); const category=normalizeCategory(b.category); const fn=normalizeFunction(b.function || old.function_code);
    if(category!=="fixo") this.assertExtraCapacity(old.shift_date, old.hours, id);
    validateFunctionSchedule(fn,old.start_time,old.end_time,old.hours); const now=Date.now(); this.sql.exec("UPDATE shifts SET doctor_id=?,function_code=?,category=?,active=1,locked=1,updated_at=? WHERE id=?",b.doctorId,fn,category,now,id);
    const current=this.sql.exec("SELECT * FROM shifts WHERE id=?",id).one(); this.audit(actor.role,actor.id,"replace","shift",id,old,current); await this.commitAndBroadcast(); return json({shift:mapShift(current)});
  }
  async adminRemoveShift(request,id){ const actor=await this.actor(request,{adminOnly:true}); const old=this.ensureShift(id); const now=Date.now(); this.sql.exec("UPDATE shifts SET active=0,locked=1,updated_at=? WHERE id=?",now,id); this.audit(actor.role,actor.id,"remove","shift",id,old,{...old,active:0}); await this.commitAndBroadcast(); return json({ok:true}); }
  async adminRecord(request){
    const actor=await this.actor(request,{adminOnly:true}); const b=await this.readJson(request); this.ensureDoctor(b.doctorId); const date=dateOnly(b.eventDate), hours=hoursValue(b.hours); const kind=String(b.kind||""); const reason=text(b.reason,500,"motivo"); if(!reason) throw new ScaleError("Informe o motivo do lançamento administrativo.");
    const id=crypto.randomUUID(), now=Date.now();
    if(kind==="atestado") this.sql.exec("INSERT INTO certificates(id,doctor_id,event_date,hours,request_id,created_at) VALUES(?,?,?,?,NULL,?)",id,b.doctorId,date,hours,now);
    else if(kind==="debt"||kind==="paid") this.sql.exec("INSERT INTO compensation(id,doctor_id,event_date,hours,kind,source,request_id,created_at) VALUES(?,?,?,?,?,?,NULL,?)",id,b.doctorId,date,hours,kind,`admin:${reason}`,now);
    else if(kind==="extra") { const category=normalizeCategory(b.category||"eventual"); if(category==="fixo") throw new ScaleError("Plantão extra deve ser eventual ou pagamento de horas."); this.assertExtraCapacity(date,hours); const fn=normalizeFunction(b.function); const start=timeOnly(b.start,"início"), end=timeOnly(b.end,"fim"); validateFunctionSchedule(fn,start,end,hours); this.sql.exec(`INSERT INTO shifts(id,shift_date,start_time,end_time,hours,doctor_id,planned_doctor_id,function_code,category,source,source_template_id,active,locked,created_at,updated_at) VALUES(?,?,?,?,?,?,NULL,?,?, 'admin-retro',NULL,1,1,?,?)`,id,date,start,end,hours,b.doctorId,fn,category,now,now); }
