{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chamador-crs-coophavila",
  "main": "src/worker-entry.js",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_ROOM",
        "class_name": "CallRoom"
      },
      {
        "name": "EXAM_STORE",
        "class_name": "ExamStore"
      }
    ]
  },
  "exports": {
    "CallRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "ExamStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
